---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { BookOpen, Cpu, ShieldCheck, Download, Award, Users, FileCheck } from 'lucide-astro';
---

<Layout
  title="About ITI Resource Hub"
  description="Learn about the mission, architecture, and educational objectives of the ITI Resource Hub for vocational training across India."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <Breadcrumbs items={[{ label: 'About the Portal' }]} />

    <div class="mt-4 mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#00b48a]">Institutional Educational Platform</span>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0a0a0a] mt-1">About ITI Resource Hub</h1>
      <p class="text-base text-[#5a5a5c] mt-2 leading-relaxed">
        A fast, centralized, public digital library built to empower vocational instructors and trainees in Industrial Training Institutes (ITIs) across India.
      </p>
    </div>

    <div class="space-y-10 text-sm text-[#3a3a3c] leading-relaxed">
      
      <!-- Mission Card -->
      <section class="p-6 sm:p-8 rounded-2xl bg-[#fafafa] border border-[#e5e5e5] space-y-4">
        <h2 class="text-xl font-bold text-[#0a0a0a] flex items-center gap-2">
          <Award class="w-5 h-5 text-[#00b48a]" />
          <span>Our Vision &amp; Mission</span>
        </h2>
        <p>
          Vocational technical education under the Directorate General of Training (DGT) and the National Council for Vocational Education and Training (NCVET) equips millions of Indian youth with essential industrial skills. However, high-quality, standardized teaching materials—such as 4-step NIMI lesson plans, workshop demonstration guides, practical wiring job sheets, and high-resolution diagrams—have historically been fragmented across disparate circulars and offline manuals.
        </p>
        <p>
          <strong>ITI Resource Hub</strong> bridges this gap by offering a single, searchable repository where any instructor can discover verified instructional aids and any trainee can download revision notes without fees, paywalls, or mandatory account creation.
        </p>
      </section>

      <!-- Key Pillars -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-[#0a0a0a]">Core Operational Principles</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl border border-[#e5e5e5] bg-white space-y-2">
            <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] flex items-center justify-center text-[#0a0a0a]">
              <ShieldCheck class="w-4 h-4 text-[#00b48a]" />
            </div>
            <h3 class="font-semibold text-[#0a0a0a]">100% Free Public Access</h3>
            <p class="text-xs text-[#5a5a5c] leading-relaxed">
              Trainees and instructors can browse, search, preview, and download all published instructional materials without registration or subscription barriers.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-[#e5e5e5] bg-white space-y-2">
            <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] flex items-center justify-center text-[#0a0a0a]">
              <Cpu class="w-4 h-4 text-[#3772cf]" />
            </div>
            <h3 class="font-semibold text-[#0a0a0a]">ICTSM Initial Specialization</h3>
            <p class="text-xs text-[#5a5a5c] leading-relaxed">
              Prioritizing Information &amp; Communication Technology System Maintenance with rich hardware, networking, fiber optics, and server administration guides, expandable to all CTS trades.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-[#e5e5e5] bg-white space-y-2">
            <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] flex items-center justify-center text-[#0a0a0a]">
              <Download class="w-4 h-4 text-[#c37d0d]" />
            </div>
            <h3 class="font-semibold text-[#0a0a0a]">Standard Formats (PDF &amp; DOCX)</h3>
            <p class="text-xs text-[#5a5a5c] leading-relaxed">
              All lesson plans are provided in portable PDF format for mobile review and editable DOCX format for instructors adapting lesson plans to their local institutional requirements.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-[#e5e5e5] bg-white space-y-2">
            <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] flex items-center justify-center text-[#0a0a0a]">
              <FileCheck class="w-4 h-4 text-[#00b48a]" />
            </div>
            <h3 class="font-semibold text-[#0a0a0a]">NIMI 4-Step Methodology</h3>
            <p class="text-xs text-[#5a5a5c] leading-relaxed">
              Lesson plans conform to the proven 4-step instructional cycle: Preparation (Motivation), Presentation, Application, and Testing/Evaluation.
            </p>
          </div>
        </div>
      </section>

      <!-- Institutional Reference Statement -->
      <section class="p-6 rounded-xl border border-[#e5e5e5] bg-white space-y-3">
        <h2 class="text-base font-bold text-[#0a0a0a]">Institutional Framework Alignment</h2>
        <p class="text-xs text-[#5a5a5c] leading-relaxed">
          The curriculum structures, trade codes, and subject topics referenced on this platform correspond to the Craftsmen Training Scheme (CTS) syllabi published by the Directorate General of Training (DGT), Ministry of Skill Development and Entrepreneurship (MSDE), Government of India, and instructional patterns formulated by the National Instructional Media Institute (NIMI), Chennai.
        </p>
      </section>

    </div>
  </div>
</Layout>
