---
import '../../styles/global.css';
import { Lock, Shield, ArrowRight, AlertCircle, CheckCircle2, BookOpen } from 'lucide-astro';
---

<!doctype html>
<html lang="en" class="h-full bg-[#f7f7f7] dark:bg-canvas-dark text-[#1c1c1e] dark:text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administrator Sign In | ITI Resource Hub</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-[#f7f7f7] dark:bg-canvas-dark text-[#1c1c1e] dark:text-ink antialiased items-center justify-center p-4">
    
    <div class="w-full max-w-md">
      
      <!-- Logo Branding -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-3">
          <div class="w-10 h-10 rounded-xl bg-[#0a0a0a] dark:bg-surface-code flex items-center justify-center text-white border border-transparent dark:border-hairline-dark shadow-sm">
            <BookOpen class="w-5 h-5 text-[#00d4a4]" />
          </div>
          <span class="font-bold text-xl text-[#0a0a0a] dark:text-ink tracking-tight">ITI Resource Hub</span>
        </a>
        <h1 class="text-xl font-bold text-[#0a0a0a] dark:text-ink">Administrator Access</h1>
        <p class="text-xs text-[#5a5a5c] dark:text-steel mt-1">Authorized instructional coordinators and portal administrators only.</p>
      </div>

      <!-- Login Card -->
      <div class="bg-white dark:bg-surface-code rounded-2xl border border-[#e5e5e5] dark:border-hairline-dark p-6 sm:p-8 shadow-sm">
        
        <!-- Error Alert Container -->
        <div id="login-error" class="hidden mb-4 p-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 text-xs rounded-xl flex items-center gap-2">
          <AlertCircle class="w-4 h-4 flex-shrink-0" />
          <span id="login-error-text">Invalid administrator credentials.</span>
        </div>

        <form id="admin-login-form" class="space-y-4">
          <div class="space-y-1">
            <label for="admin-email" class="text-xs font-semibold text-[#0a0a0a] dark:text-ink block">Administrator Email</label>
            <input
              type="email"
              id="admin-email"
              required
              value="admin@iti-hub.gov.in"
              placeholder="admin@iti-hub.gov.in"
              class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] dark:border-hairline-dark bg-white dark:bg-surface text-xs text-[#0a0a0a] dark:text-ink placeholder-[#888888] dark:placeholder-stone focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="admin-password" class="text-xs font-semibold text-[#0a0a0a] dark:text-ink">Password</label>
            </div>
            <input
              type="password"
              id="admin-password"
              required
              value="AdminPass2026!"
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] dark:border-hairline-dark bg-white dark:bg-surface text-xs text-[#0a0a0a] dark:text-ink placeholder-[#888888] dark:placeholder-stone focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
            />
          </div>

          <!-- Demo Credentials Banner -->
          <div class="p-3 bg-[#fafafa] dark:bg-surface rounded-lg border border-[#ededed] dark:border-hairline-dark text-[11px] text-[#5a5a5c] dark:text-steel space-y-1">
            <div class="font-semibold text-[#0a0a0a] dark:text-ink flex items-center gap-1">
              <Shield class="w-3.5 h-3.5 text-[#00b48a] dark:text-brand-green" />
              <span>Development Provisioned Credentials:</span>
            </div>
            <div>Email: <code class="font-mono bg-white dark:bg-surface-code px-1 py-0.5 rounded border border-[#e5e5e5] dark:border-hairline-dark text-[#0a0a0a] dark:text-ink">admin@iti-hub.gov.in</code></div>
            <div>Password: <code class="font-mono bg-white dark:bg-surface-code px-1 py-0.5 rounded border border-[#e5e5e5] dark:border-hairline-dark text-[#0a0a0a] dark:text-ink">AdminPass2026!</code></div>
          </div>

          <button
            type="submit"
            id="login-submit-btn"
            class="w-full py-2.5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white dark:bg-white dark:text-[#0a0a0a] dark:hover:bg-slate-200 rounded-full text-xs font-medium transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <Lock class="w-3.5 h-3.5 text-[#00d4a4] dark:text-brand-green-deep" />
            <span>Sign In to Admin Console</span>
          </button>
        </form>

      </div>

      <div class="text-center mt-6 text-xs text-[#888888] dark:text-stone">
        <a href="/" class="hover:text-[#0a0a0a] dark:hover:text-ink transition-colors underline">
          ← Return to Public Portal
        </a>
      </div>

    </div>

    <script>
      const form = document.getElementById('admin-login-form') as HTMLFormElement;
      const emailInput = document.getElementById('admin-email') as HTMLInputElement;
      const passInput = document.getElementById('admin-password') as HTMLInputElement;
      const errorBox = document.getElementById('login-error');
      const errorText = document.getElementById('login-error-text');

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim();
        const pass = passInput?.value;

        // Valid development administrator credentials or custom provision
        if ((email === 'admin@iti-hub.gov.in' && pass === 'AdminPass2026!') || (email && pass && pass.length >= 8)) {
          localStorage.setItem('iti_admin_authenticated', 'true');
          localStorage.setItem('iti_admin_email', email);
          window.location.href = '/admin';
        } else {
          if (errorBox && errorText) {
            errorText.textContent = 'Invalid administrator credentials. Password must be at least 8 characters.';
            errorBox.classList.remove('hidden');
          }
        }
      });
    </script>
  </body>
</html>
