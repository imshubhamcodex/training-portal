---
import '../../styles/global.css';
import { Lock, Shield, ArrowRight, AlertCircle, CheckCircle2, BookOpen } from 'lucide-astro';
---

<!doctype html>
<html lang="en" class="h-full bg-[#f7f7f7]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administrator Sign In | ITI Resource Hub</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex flex-col min-h-screen text-[#1c1c1e] antialiased items-center justify-center p-4">
    
    <div class="w-full max-w-md">
      
      <!-- Logo Branding -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-3">
          <div class="w-10 h-10 rounded-xl bg-[#0a0a0a] flex items-center justify-center text-white shadow-sm">
            <BookOpen class="w-5 h-5 text-[#00d4a4]" />
          </div>
          <span class="font-bold text-xl text-[#0a0a0a] tracking-tight">ITI Resource Hub</span>
        </a>
        <h1 class="text-xl font-bold text-[#0a0a0a]">Administrator Access</h1>
        <p class="text-xs text-[#5a5a5c] mt-1">Authorized instructional coordinators and portal administrators only.</p>
      </div>

      <!-- Login Card -->
      <div class="bg-white rounded-2xl border border-[#e5e5e5] p-6 sm:p-8 shadow-sm">
        
        <!-- Error Alert Container -->
        <div id="login-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2">
          <AlertCircle class="w-4 h-4 flex-shrink-0" />
          <span id="login-error-text">Invalid administrator credentials.</span>
        </div>

        <form id="admin-login-form" class="space-y-4">
          <div class="space-y-1">
            <label for="admin-email" class="text-xs font-semibold text-[#0a0a0a] block">Administrator Email</label>
            <input
              type="email"
              id="admin-email"
              required
              value="admin@iti-hub.gov.in"
              placeholder="admin@iti-hub.gov.in"
              class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="admin-password" class="text-xs font-semibold text-[#0a0a0a]">Password</label>
            </div>
            <input
              type="password"
              id="admin-password"
              required
              value="AdminPass2026!"
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
            />
          </div>

          <!-- Demo Credentials Banner -->
          <div class="p-3 bg-[#fafafa] rounded-lg border border-[#ededed] text-[11px] text-[#5a5a5c] space-y-1">
            <div class="font-semibold text-[#0a0a0a] flex items-center gap-1">
              <Shield class="w-3.5 h-3.5 text-[#00b48a]" />
              <span>Development Provisioned Credentials:</span>
            </div>
            <div>Email: <code class="font-mono bg-white px-1 py-0.5 rounded border border-[#e5e5e5]">admin@iti-hub.gov.in</code></div>
            <div>Password: <code class="font-mono bg-white px-1 py-0.5 rounded border border-[#e5e5e5]">AdminPass2026!</code></div>
          </div>

          <button
            type="submit"
            id="login-submit-btn"
            class="w-full py-2.5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors flex items-center justify-center gap-2"
          >
            <Lock class="w-3.5 h-3.5 text-[#00d4a4]" />
            <span>Sign In to Admin Console</span>
          </button>
        </form>

      </div>

      <div class="text-center mt-6 text-xs text-[#888888]">
        <a href="/" class="hover:text-[#0a0a0a] transition-colors underline">
          ← Return to Public Portal
        </a>
      </div>

    </div>

    <script>
      const form = document.getElementById('admin-login-form') as HTMLFormElement;
      const emailInput = document.getElementById('admin-email') as HTMLInputElement;
      const passInput = document.getElementById('admin-password') as HTMLInputElement;
      const errorBox = document.getElementById('login-error');
      const errorText = document.getElementById('login-error-text');

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim();
        const pass = passInput?.value;

        // Valid development administrator credentials or custom provision
        if ((email === 'admin@iti-hub.gov.in' && pass === 'AdminPass2026!') || (email && pass && pass.length >= 8)) {
          localStorage.setItem('iti_admin_authenticated', 'true');
          localStorage.setItem('iti_admin_email', email);
          window.location.href = '/admin';
        } else {
          if (errorBox && errorText) {
            errorText.textContent = 'Invalid administrator credentials. Password must be at least 8 characters.';
            errorBox.classList.remove('hidden');
          }
        }
      });
    </script>
  </body>
</html>
