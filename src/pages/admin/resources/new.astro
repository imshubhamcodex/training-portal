---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getActiveTrades } from '../../../lib/data/trades';
import { getAllSubjects } from '../../../lib/data/subjects';
import { RESOURCE_CATEGORIES } from '../../../lib/data/categories';
import { Save, Upload, CheckCircle2, ArrowLeft, AlertCircle } from 'lucide-astro';

const trades = getActiveTrades();
const subjects = getAllSubjects();
---

<AdminLayout title="Add New Resource" activeNav="new-resource">
  
  <div class="flex items-center gap-2 mb-4">
    <a href="/admin/resources" class="text-xs font-medium text-[#5a5a5c] hover:text-[#0a0a0a] flex items-center gap-1">
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>Back to resources list</span>
    </a>
  </div>

  <div class="pb-4 border-b border-[#e5e5e5] mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-[#0a0a0a]">Add New Instructional Resource</h1>
    <p class="text-xs text-[#5a5a5c] mt-0.5">Upload a verified lesson plan, practical demonstration plan, or lab guide.</p>
  </div>

  <div id="create-success" class="hidden mb-6 p-4 rounded-xl bg-[#00d4a4]/10 border border-[#00d4a4]/30 text-[#00b48a] text-xs font-medium flex items-center gap-2">
    <CheckCircle2 class="w-5 h-5 flex-shrink-0" />
    <span>Resource successfully saved and added to the educational library!</span>
  </div>

  <form id="create-resource-form" class="space-y-6">
    
    <!-- Section 1: Basic Information -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-6 space-y-4 shadow-xs">
      <h2 class="text-sm font-bold text-[#0a0a0a] pb-2 border-b border-[#ededed]">1. Resource Information</h2>

      <div class="space-y-1">
        <label for="title" class="text-xs font-semibold text-[#0a0a0a]">Resource Title *</label>
        <input
          type="text"
          id="title"
          required
          placeholder="e.g. Lesson Plan 04: Structured Cabling and Cable Testing"
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label for="resource-type" class="text-xs font-semibold text-[#0a0a0a]">Resource Type *</label>
          <select
            id="resource-type"
            required
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            <option value="lesson-plan">Lesson Plan (Theory)</option>
            <option value="demonstration-plan">Demonstration Plan (Practical)</option>
            <option value="lab-manual">Lab Manual / Job Sheet</option>
            <option value="notes">Subject Notes &amp; Handouts</option>
            <option value="diagram">Technical Diagram / Schematic</option>
          </select>
        </div>

        <div class="space-y-1">
          <label for="language" class="text-xs font-semibold text-[#0a0a0a]">Language *</label>
          <select
            id="language"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            <option value="English">English</option>
            <option value="Hindi">Hindi</option>
            <option value="Bilingual">Bilingual (English + Hindi)</option>
          </select>
        </div>
      </div>

      <div class="space-y-1">
        <label for="description" class="text-xs font-semibold text-[#0a0a0a]">Instructional Objectives &amp; Description *</label>
        <textarea
          id="description"
          rows="3"
          required
          placeholder="Summarize instructional goals, required workshop tools, and evaluation criteria..."
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        ></textarea>
      </div>
    </div>

    <!-- Section 2: Curriculum Association -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-6 space-y-4 shadow-xs">
      <h2 class="text-sm font-bold text-[#0a0a0a] pb-2 border-b border-[#ededed]">2. Curriculum Alignment</h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="space-y-1">
          <label for="trade-select" class="text-xs font-semibold text-[#0a0a0a]">Trade *</label>
          <select
            id="trade-select"
            required
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            {trades.map((t) => (
              <option value={t.id}>{t.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1">
          <label for="subject-select" class="text-xs font-semibold text-[#0a0a0a]">Subject *</label>
          <select
            id="subject-select"
            required
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            {subjects.map((s) => (
              <option value={s.id}>{s.name} (Yr {s.training_year})</option>
            ))}
          </select>
        </div>

        <div class="space-y-1">
          <label for="training-year" class="text-xs font-semibold text-[#0a0a0a]">Training Year *</label>
          <select
            id="training-year"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            <option value="1">Year 1</option>
            <option value="2">Year 2</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label for="author-name" class="text-xs font-semibold text-[#0a0a0a]">Author / Senior Instructor</label>
          <input
            type="text"
            id="author-name"
            placeholder="e.g. Senior Technical Instructor, ITI"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          />
        </div>

        <div class="space-y-1">
          <label for="source-name" class="text-xs font-semibold text-[#0a0a0a]">Issuing / Reference Framework</label>
          <input
            type="text"
            id="source-name"
            placeholder="e.g. NIMI Instructional Framework"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          />
        </div>
      </div>

      <div class="space-y-1">
        <label for="tags" class="text-xs font-semibold text-[#0a0a0a]">Curriculum Topic Tags (comma separated)</label>
        <input
          type="text"
          id="tags"
          placeholder="e.g. Cat6, Punch Down, Keystone Jack, Continuity Test"
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        />
      </div>
    </div>

    <!-- Section 3: File Attachment & Publishing Status -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-6 space-y-4 shadow-xs">
      <h2 class="text-sm font-bold text-[#0a0a0a] pb-2 border-b border-[#ededed]">3. File Attachment &amp; Status</h2>

      <div class="border-2 border-dashed border-[#e5e5e5] rounded-xl p-6 text-center hover:border-[#00d4a4] transition-colors bg-[#fafafa]">
        <Upload class="w-8 h-8 text-[#888888] mx-auto mb-2" />
        <span class="text-xs font-semibold text-[#0a0a0a] block">Select PDF or DOCX file to attach</span>
        <span class="text-[11px] text-[#5a5a5c] block mt-0.5">Permitted formats: .pdf, .docx, .svg, .png (Max 25MB)</span>
        <input
          type="file"
          id="file-upload"
          class="mt-3 text-xs text-[#5a5a5c]"
          accept=".pdf,.docx,.doc,.svg,.png,.jpg"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="space-y-1">
          <label for="status" class="text-xs font-semibold text-[#0a0a0a]">Publication Status *</label>
          <select
            id="status"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          >
            <option value="published">Published (Visible immediately)</option>
            <option value="draft">Draft (Save for review)</option>
          </select>
        </div>

        <div class="flex items-center gap-2 pt-6">
          <input
            type="checkbox"
            id="is-featured"
            class="rounded border-[#e5e5e5] text-[#00d4a4] focus:ring-[#00d4a4]"
          />
          <label for="is-featured" class="text-xs font-semibold text-[#0a0a0a]">
            Mark as Featured Resource on Homepage
          </label>
        </div>
      </div>
    </div>

    <!-- Submit Button Bar -->
    <div class="flex items-center justify-end gap-3 pt-4">
      <a
        href="/admin/resources"
        class="px-5 py-2.5 bg-white border border-[#e5e5e5] text-[#1c1c1e] rounded-full text-xs font-medium hover:bg-[#f7f7f7] transition-colors"
      >
        Cancel
      </a>
      <button
        type="submit"
        class="px-6 py-2.5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors flex items-center gap-2"
      >
        <Save class="w-4 h-4 text-[#00d4a4]" />
        <span>Save &amp; Publish Resource</span>
      </button>
    </div>

  </form>

  <script>
    const form = document.getElementById('create-resource-form') as HTMLFormElement;
    const successBox = document.getElementById('create-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successBox) {
        successBox.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => {
          window.location.href = '/admin/resources';
        }, 1200);
      }
    });
  </script>
</AdminLayout>
