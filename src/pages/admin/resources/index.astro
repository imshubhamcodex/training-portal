---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getAllResources } from '../../../lib/data/resources';
import { PlusCircle, Search, Edit3, ExternalLink, Trash2, CheckCircle2, Clock } from 'lucide-astro';

const allResources = getAllResources(true);
---

<AdminLayout title="Resource Management" activeNav="resources">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e5e5e5] dark:border-hairline-dark">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-[#0a0a0a] dark:text-ink">Resource Management</h1>
      <p class="text-xs text-[#5a5a5c] dark:text-steel mt-0.5">Create, edit, publish, archive, or replace downloadable training files.</p>
    </div>

    <a
      href="/admin/resources/new"
      class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white dark:bg-white dark:text-[#0a0a0a] dark:hover:bg-slate-200 rounded-full text-xs font-medium transition-colors self-start sm:self-auto cursor-pointer"
    >
      <PlusCircle class="w-3.5 h-3.5 text-[#00d4a4] dark:text-brand-green-deep" />
      <span>Create New Resource</span>
    </a>
  </div>

  <!-- Resource Table Card -->
  <div class="bg-white dark:bg-surface-code rounded-xl border border-[#e5e5e5] dark:border-hairline-dark shadow-xs overflow-hidden">
    
    <!-- Table Header Controls -->
    <div class="p-4 border-b border-[#ededed] dark:border-hairline-dark flex flex-col sm:flex-row items-center justify-between gap-3 bg-[#fafafa] dark:bg-surface">
      <div class="text-xs font-semibold text-[#0a0a0a] dark:text-ink">
        Total Records: <span class="font-normal text-[#5a5a5c] dark:text-steel">{allResources.length} items</span>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <input
          type="text"
          id="resource-filter-input"
          placeholder="Filter by title or trade..."
          class="px-3 py-1.5 bg-white dark:bg-surface-code border border-[#e5e5e5] dark:border-hairline-dark rounded-lg text-xs text-[#0a0a0a] dark:text-ink placeholder-[#888888] dark:placeholder-stone focus:outline-none focus:ring-2 focus:ring-[#00d4a4] w-full sm:w-64"
        />
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#fafafa] dark:bg-surface border-b border-[#e5e5e5] dark:border-hairline-dark text-[#5a5a5c] dark:text-steel font-semibold uppercase tracking-wider text-[10px]">
          <tr>
            <th class="py-3 px-4">Title &amp; Type</th>
            <th class="py-3 px-4">Trade &amp; Subject</th>
            <th class="py-3 px-4">Year</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Format</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#ededed] dark:divide-hairline-dark text-[#1c1c1e] dark:text-charcoal" id="resources-table-body">
          {allResources.map((res) => {
            const primary = res.files[0];
            const ext = primary ? primary.original_filename.split('.').pop()?.toUpperCase() : 'PDF';
            return (
              <tr class="hover:bg-[#fafafa] dark:hover:bg-surface/50 transition-colors resource-row" data-search={`${res.title} ${res.trade_name} ${res.subject_name}`}>
                <td class="py-3.5 px-4 max-w-xs">
                  <div class="font-semibold text-[#0a0a0a] dark:text-ink line-clamp-1">{res.title}</div>
                  <span class="text-[10px] text-[#5a5a5c] dark:text-steel uppercase font-mono">{res.resource_type}</span>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <div class="font-medium text-[#0a0a0a] dark:text-ink">{res.trade_name}</div>
                  <div class="text-[#888888] dark:text-stone text-[11px] truncate max-w-[140px]">{res.subject_name}</div>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap font-mono text-[#5a5a5c] dark:text-steel">
                  Yr {res.training_year}
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold ${
                    res.status === 'published' ? 'bg-[#00d4a4]/15 text-[#00b48a] dark:text-brand-green' : 'bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300'
                  }`}>
                    {res.status === 'published' ? <CheckCircle2 class="w-3 h-3" /> : <Clock class="w-3 h-3" />}
                    <span>{res.status.toUpperCase()}</span>
                  </span>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap font-mono text-[11px] text-[#5a5a5c] dark:text-steel">
                  {ext}
                </td>
                <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-1.5">
                  <a
                    href={`/admin/resources/${res.id}/edit`}
                    class="inline-flex items-center gap-1 px-2.5 py-1 text-xs bg-[#f7f7f7] dark:bg-surface hover:bg-[#ededed] dark:hover:bg-surface-soft rounded font-medium text-[#0a0a0a] dark:text-ink border border-transparent dark:border-hairline-dark transition-colors"
                  >
                    <Edit3 class="w-3 h-3" />
                    <span>Edit</span>
                  </a>
                  {res.status === 'published' && (
                    <a
                      href={`/resources/${res.slug}`}
                      target="_blank"
                      class="inline-flex items-center p-1 text-[#888888] dark:text-stone hover:text-[#0a0a0a] dark:hover:text-ink"
                      title="View on site"
                    >
                      <ExternalLink class="w-3.5 h-3.5" />
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

  </div>

  <script>
    const filterInput = document.getElementById('resource-filter-input') as HTMLInputElement;
    const rows = document.querySelectorAll('.resource-row');

    filterInput?.addEventListener('input', () => {
      const q = filterInput.value.toLowerCase().trim();
      rows.forEach((row) => {
        const text = row.getAttribute('data-search')?.toLowerCase() || '';
        if (text.includes(q)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  </script>
</AdminLayout>
