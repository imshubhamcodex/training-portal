---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { getAllTrades } from '../../lib/data/trades';
import { getTradeResourceCount } from '../../lib/data/resources';
import { PlusCircle, Cpu, CheckCircle2, XCircle, Edit, ArrowRight } from 'lucide-astro';

const trades = getAllTrades();
---

<AdminLayout title="Trade Management" activeNav="trades">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e5e5e5]">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-[#0a0a0a]">Trade Management</h1>
      <p class="text-xs text-[#5a5a5c] mt-0.5">Configure Craftsmen Training Scheme (CTS) vocational trades.</p>
    </div>

    <button
      type="button"
      onclick="alert('Add Trade modal: In Supabase production, this inserts a new trade into public.trades.');"
      class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors"
    >
      <PlusCircle class="w-3.5 h-3.5 text-[#00d4a4]" />
      <span>Add New Trade</span>
    </button>
  </div>

  <div class="bg-white rounded-xl border border-[#e5e5e5] shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#fafafa] border-b border-[#e5e5e5] text-[#5a5a5c] font-semibold uppercase tracking-wider text-[10px]">
          <tr>
            <th class="py-3 px-4">Trade Name &amp; Slug</th>
            <th class="py-3 px-4">Code</th>
            <th class="py-3 px-4">Duration</th>
            <th class="py-3 px-4">Resources</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#ededed] text-[#1c1c1e]">
          {trades.map((trade) => {
            const count = getTradeResourceCount(trade.id);
            return (
              <tr class="hover:bg-[#fafafa] transition-colors">
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-[#0a0a0a]">{trade.name}</div>
                  <span class="text-[11px] font-mono text-[#888888]">/{trade.slug}</span>
                </td>
                <td class="py-3.5 px-4 font-mono font-medium">{trade.code}</td>
                <td class="py-3.5 px-4">{trade.duration_years} Years</td>
                <td class="py-3.5 px-4 font-semibold">{count} Published</td>
                <td class="py-3.5 px-4">
                  {trade.is_active ? (
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#00b48a] bg-[#00d4a4]/15 px-2 py-0.5 rounded-full">
                      <CheckCircle2 class="w-3 h-3" />
                      Active
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
                      <XCircle class="w-3 h-3" />
                      Inactive
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`/trades/${trade.slug}`}
                    target="_blank"
                    class="px-2.5 py-1 text-xs bg-[#f7f7f7] hover:bg-[#ededed] rounded text-[#0a0a0a] transition-colors inline-flex items-center gap-1"
                  >
                    <span>View Portal</span>
                    <ArrowRight class="w-3 h-3" />
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

</AdminLayout>
