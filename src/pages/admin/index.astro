---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { getAllResources } from '../../lib/data/resources';
import { getActiveTrades } from '../../lib/data/trades';
import { getAllNotices, getActiveNotices } from '../../lib/data/notices';
import {
  FileText,
  FileClock,
  Cpu,
  Bell,
  PlusCircle,
  ArrowRight,
  ExternalLink,
  CheckCircle2,
  Clock,
  Layers,
  Sparkles,
} from 'lucide-astro';

// Calculate ACTUAL database counts (no fabricated metrics)
const allResources = getAllResources(true); // includes drafts
const publishedResources = allResources.filter((r) => r.status === 'published');
const draftResources = allResources.filter((r) => r.status === 'draft');
const activeTrades = getActiveTrades();
const allNotices = getAllNotices(true);
const publishedNotices = allNotices.filter((n) => n.status === 'published');

const recentResources = [...allResources]
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
  .slice(0, 5);
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e5e5e5]">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-[#0a0a0a]">Administrator Dashboard</h1>
      <p class="text-xs text-[#5a5a5c] mt-0.5">Real-time status of published educational resources, trades, and circulars.</p>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/admin/resources/new"
        class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors"
      >
        <PlusCircle class="w-3.5 h-3.5 text-[#00d4a4]" />
        <span>Add Resource</span>
      </a>
      <a
        href="/admin/notices"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-[#fafafa] border border-[#e5e5e5] rounded-full text-xs font-medium text-[#1c1c1e] transition-colors"
      >
        <Bell class="w-3.5 h-3.5 text-[#c37d0d]" />
        <span>New Notice</span>
      </a>
    </div>
  </div>

  <!-- Metric Stat Cards (Real Database Counts) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- Published Resources -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-[#5a5a5c]">Published Resources</span>
        <div class="w-8 h-8 rounded-lg bg-[#00d4a4]/10 text-[#00b48a] flex items-center justify-center">
          <FileText class="w-4 h-4" />
        </div>
      </div>
      <div class="text-3xl font-bold text-[#0a0a0a] tracking-tight">{publishedResources.length}</div>
      <div class="text-[11px] text-[#00b48a] font-medium mt-1 flex items-center gap-1">
        <CheckCircle2 class="w-3 h-3" />
        <span>Live on public catalog</span>
      </div>
    </div>

    <!-- Draft Resources -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-[#5a5a5c]">Draft Resources</span>
        <div class="w-8 h-8 rounded-lg bg-[rgba(195,125,13,0.1)] text-[#c37d0d] flex items-center justify-center">
          <FileClock class="w-4 h-4" />
        </div>
      </div>
      <div class="text-3xl font-bold text-[#0a0a0a] tracking-tight">{draftResources.length}</div>
      <div class="text-[11px] text-[#5a5a5c] mt-1 flex items-center gap-1">
        <Clock class="w-3 h-3 text-[#c37d0d]" />
        <span>Awaiting review / publishing</span>
      </div>
    </div>

    <!-- Active Trades -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-[#5a5a5c]">Active ITI Trades</span>
        <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] text-[#0a0a0a] flex items-center justify-center border border-[#e5e5e5]">
          <Cpu class="w-4 h-4 text-[#3772cf]" />
        </div>
      </div>
      <div class="text-3xl font-bold text-[#0a0a0a] tracking-tight">{activeTrades.length}</div>
      <div class="text-[11px] text-[#5a5a5c] mt-1">
        ICTSM, Electrician, Fitter, COPA
      </div>
    </div>

    <!-- Published Notices -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-[#5a5a5c]">Published Circulars</span>
        <div class="w-8 h-8 rounded-lg bg-[#f7f7f7] text-[#c37d0d] flex items-center justify-center border border-[#e5e5e5]">
          <Bell class="w-4 h-4" />
        </div>
      </div>
      <div class="text-3xl font-bold text-[#0a0a0a] tracking-tight">{publishedNotices.length}</div>
      <div class="text-[11px] text-[#5a5a5c] mt-1">
        DGT &amp; NCVET Official Notices
      </div>
    </div>

  </div>

  <!-- Recent Submissions Table & Quick Actions Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Recent Resources Table (2 cols) -->
    <div class="lg:col-span-2 bg-white rounded-xl border border-[#e5e5e5] p-6 shadow-xs">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#ededed]">
        <h2 class="text-sm font-bold text-[#0a0a0a]">Recently Added Resources</h2>
        <a href="/admin/resources" class="text-xs text-[#0a0a0a] hover:text-[#00b48a] font-medium flex items-center gap-1">
          <span>View all ({allResources.length})</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="divide-y divide-[#ededed]">
        {recentResources.map((res) => (
          <div class="py-3 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`px-2 py-0.5 text-[10px] font-semibold rounded ${
                  res.status === 'published' ? 'bg-[#00d4a4]/15 text-[#00b48a]' : 'bg-amber-100 text-amber-800'
                }`}>
                  {res.status.toUpperCase()}
                </span>
                <span class="text-[11px] font-medium text-[#5a5a5c]">{res.trade_name}</span>
                <span class="text-[11px] text-[#888888] font-mono">Yr {res.training_year}</span>
              </div>
              <h3 class="text-xs font-semibold text-[#0a0a0a] truncate">
                {res.title}
              </h3>
            </div>

            <div class="flex items-center gap-2 flex-shrink-0">
              <a
                href={`/admin/resources/${res.id}/edit`}
                class="px-2.5 py-1 text-xs font-medium bg-[#f7f7f7] hover:bg-[#ededed] rounded text-[#1c1c1e] transition-colors"
              >
                Edit
              </a>
              {res.status === 'published' && (
                <a
                  href={`/resources/${res.slug}`}
                  target="_blank"
                  class="p-1 text-[#888888] hover:text-[#0a0a0a]"
                  title="View live"
                >
                  <ExternalLink class="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick Management Panel (1 col) -->
    <div class="space-y-4">
      <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 shadow-xs space-y-4">
        <h3 class="text-xs font-bold text-[#0a0a0a] uppercase tracking-wider pb-2 border-b border-[#ededed]">
          Quick Navigation
        </h3>

        <div class="space-y-2">
          <a
            href="/admin/resources/new"
            class="flex items-center justify-between p-3 rounded-lg border border-[#f0f0f0] hover:border-[#b3b3b3] hover:bg-[#fafafa] transition-all text-xs font-semibold text-[#0a0a0a]"
          >
            <span class="flex items-center gap-2">
              <PlusCircle class="w-4 h-4 text-[#00b48a]" />
              <span>Upload New Lesson / Lab Manual</span>
            </span>
            <ArrowRight class="w-3.5 h-3.5 text-[#888888]" />
          </a>

          <a
            href="/admin/trades"
            class="flex items-center justify-between p-3 rounded-lg border border-[#f0f0f0] hover:border-[#b3b3b3] hover:bg-[#fafafa] transition-all text-xs font-semibold text-[#0a0a0a]"
          >
            <span class="flex items-center gap-2">
              <Cpu class="w-4 h-4 text-[#3772cf]" />
              <span>Configure Trades &amp; Curricula</span>
            </span>
            <ArrowRight class="w-3.5 h-3.5 text-[#888888]" />
          </a>

          <a
            href="/admin/notices"
            class="flex items-center justify-between p-3 rounded-lg border border-[#f0f0f0] hover:border-[#b3b3b3] hover:bg-[#fafafa] transition-all text-xs font-semibold text-[#0a0a0a]"
          >
            <span class="flex items-center gap-2">
              <Bell class="w-4 h-4 text-[#c37d0d]" />
              <span>Publish Circular / Exam Notice</span>
            </span>
            <ArrowRight class="w-3.5 h-3.5 text-[#888888]" />
          </a>

          <a
            href="/admin/settings"
            class="flex items-center justify-between p-3 rounded-lg border border-[#f0f0f0] hover:border-[#b3b3b3] hover:bg-[#fafafa] transition-all text-xs font-semibold text-[#0a0a0a]"
          >
            <span class="flex items-center gap-2">
              <Sparkles class="w-4 h-4 text-[#5a5a5c]" />
              <span>Supabase Connection &amp; Sync</span>
            </span>
            <ArrowRight class="w-3.5 h-3.5 text-[#888888]" />
          </a>
        </div>
      </div>

      <!-- System Status Notice -->
      <div class="bg-[#fafafa] rounded-xl border border-[#e5e5e5] p-4 text-xs text-[#5a5a5c] space-y-1">
        <div class="font-semibold text-[#0a0a0a] flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#00d4a4]"></span>
          <span>Security &amp; RLS Status: Operational</span>
        </div>
        <p class="leading-relaxed text-[11px]">
          Public anonymous requests are restricted to published records. Drafts and unapproved files remain protected.
        </p>
      </div>
    </div>

  </div>

</AdminLayout>
