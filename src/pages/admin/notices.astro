---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { getAllNotices, isNoticeExpired } from '../../lib/data/notices';
import { PlusCircle, Bell, Calendar, Building2, ExternalLink, CheckCircle2, Clock } from 'lucide-astro';

const notices = getAllNotices(true);
---

<AdminLayout title="Notice Management" activeNav="notices">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e5e5e5]">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-[#0a0a0a]">Notices &amp; Circular Management</h1>
      <p class="text-xs text-[#5a5a5c] mt-0.5">Publish regulatory notifications, trade test schedules, and safety directives.</p>
    </div>

    <button
      type="button"
      id="open-notice-modal-btn"
      class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors"
    >
      <PlusCircle class="w-3.5 h-3.5 text-[#00d4a4]" />
      <span>Create New Notice</span>
    </button>
  </div>

  <!-- Notice Creation Card (Collapsible) -->
  <div id="new-notice-panel" class="hidden bg-white rounded-xl border border-[#00d4a4] p-6 shadow-sm space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-[#ededed]">
      <h2 class="text-sm font-bold text-[#0a0a0a]">Draft New Official Notice</h2>
      <button type="button" id="close-notice-panel" class="text-xs text-[#888888] hover:text-[#0a0a0a]">Close ✕</button>
    </div>

    <form id="create-notice-form" class="space-y-4">
      <div class="space-y-1">
        <label class="text-xs font-semibold text-[#0a0a0a]">Notice Title *</label>
        <input
          type="text"
          required
          placeholder="e.g. Schedule of Practical Examinations for All India Trade Test (AITT)"
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#0a0a0a]">Category *</label>
          <select class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]">
            <option value="curriculum">Curriculum</option>
            <option value="exam">Examination</option>
            <option value="circular">Circular</option>
            <option value="general">General</option>
          </select>
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#0a0a0a]">Issuing Authority *</label>
          <input
            type="text"
            required
            placeholder="e.g. DGT / NCVET"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          />
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#0a0a0a]">Validity / Expiry Date</label>
          <input
            type="date"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] bg-white focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          />
        </div>
      </div>

      <div class="space-y-1">
        <label class="text-xs font-semibold text-[#0a0a0a]">Notice Body Text *</label>
        <textarea
          rows="4"
          required
          placeholder="Enter full announcement text, instructions, and deadlines..."
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#e5e5e5] text-xs text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        ></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="submit"
          class="px-5 py-2.5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors"
        >
          Publish Notice
        </button>
      </div>
    </form>
  </div>

  <!-- Notices Table -->
  <div class="bg-white rounded-xl border border-[#e5e5e5] shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#fafafa] border-b border-[#e5e5e5] text-[#5a5a5c] font-semibold uppercase tracking-wider text-[10px]">
          <tr>
            <th class="py-3 px-4">Notice Title</th>
            <th class="py-3 px-4">Authority</th>
            <th class="py-3 px-4">Category</th>
            <th class="py-3 px-4">Published</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">View</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#ededed] text-[#1c1c1e]">
          {notices.map((notice) => {
            const expired = isNoticeExpired(notice);
            const pubDate = new Date(notice.published_at).toLocaleDateString('en-IN', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            });
            return (
              <tr class="hover:bg-[#fafafa] transition-colors">
                <td class="py-3.5 px-4 max-w-sm">
                  <div class="font-semibold text-[#0a0a0a] line-clamp-1">{notice.title}</div>
                  <span class="text-[10px] text-[#888888]">/{notice.slug}</span>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap font-medium text-[#0a0a0a]">
                  {notice.source_name || 'Portal Desk'}
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap uppercase text-[10px] font-mono">
                  {notice.category}
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap text-[#5a5a5c]">
                  {pubDate}
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  {expired ? (
                    <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-[#f7f7f7] text-[#888888] border border-[#e5e5e5]">
                      Expired
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-[#00d4a4]/15 text-[#00b48a]">
                      <CheckCircle2 class="w-3 h-3" />
                      Active
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                  <a
                    href={`/notices/${notice.slug}`}
                    target="_blank"
                    class="p-1 text-[#888888] hover:text-[#0a0a0a] inline-flex items-center gap-1"
                  >
                    <span>Preview</span>
                    <ExternalLink class="w-3.5 h-3.5" />
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const openBtn = document.getElementById('open-notice-modal-btn');
    const closeBtn = document.getElementById('close-notice-panel');
    const panel = document.getElementById('new-notice-panel');
    const form = document.getElementById('create-notice-form');

    openBtn?.addEventListener('click', () => {
      panel?.classList.remove('hidden');
      panel?.scrollIntoView({ behavior: 'smooth' });
    });

    closeBtn?.addEventListener('click', () => {
      panel?.classList.add('hidden');
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Notice successfully published!');
      panel?.classList.add('hidden');
      window.location.reload();
    });
  </script>
</AdminLayout>
