---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';
import { getAllResources, getResourceBySlug, getRelatedResources } from '../../lib/data/resources';
import {
  Download,
  FileText,
  Calendar,
  User,
  Building2,
  Sparkles,
  Layers,
  Cpu,
  Share2,
  ExternalLink,
  ShieldCheck,
  Eye,
  FileCheck,
  AlertCircle,
  HelpCircle,
} from 'lucide-astro';

export async function getStaticPaths() {
  const resources = getAllResources();
  return resources.map((resource) => ({
    params: { resourceSlug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const relatedResources = getRelatedResources(resource.id, 3);

const primaryFile = resource.files.find((f) => f.is_primary) || resource.files[0];
const otherFiles = resource.files.filter((f) => f.id !== primaryFile?.id);

const pubDate = new Date(resource.published_at || resource.created_at).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const updDate = new Date(resource.updated_at).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const isPdf = primaryFile?.mime_type === 'application/pdf';
const isSvgOrImage = primaryFile?.mime_type?.startsWith('image/');
---

<Layout
  title={`${resource.title} - ${resource.trade_name}`}
  description={resource.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <Breadcrumbs
      items={[
        { label: 'Library', href: '/library' },
        { label: resource.trade_name, href: `/trades/${resource.trade_slug}` },
        { label: resource.subject_name, href: `/trades/${resource.trade_slug}/subjects/${resource.subject_slug}` },
        { label: resource.title },
      ]}
    />

    <!-- Main Resource Layout: 2 Columns (Content & Preview on Left, Metadata & Download on Right) -->
    <div class="mt-4 grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column (Span 2): Header, Document Preview, Description, Topics -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Header Info -->
        <div class="space-y-3 pb-6 border-b border-hairline dark:border-hairline-dark">
          <div class="flex items-center gap-2 flex-wrap">
            <Badge variant="mint" size="md">
              {resource.resource_type.toUpperCase().replace('-', ' ')}
            </Badge>
            <a
              href={`/trades/${resource.trade_slug}`}
              class="text-xs font-semibold px-2.5 py-1 bg-surface dark:bg-surface-code hover:bg-hairline-soft dark:hover:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark transition-colors"
            >
              {resource.trade_name}
            </a>
            <span class="text-xs font-mono text-steel dark:text-on-dark-muted px-2 py-0.5 bg-surface-soft dark:bg-surface-code rounded border border-hairline-soft dark:border-hairline-dark">
              Year {resource.training_year}
            </span>
            <span class="text-xs font-mono text-stone dark:text-on-dark-muted">
              {resource.version_label}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink dark:text-on-dark leading-tight">
            {resource.title}
          </h1>

          <div class="flex items-center gap-4 text-xs text-steel dark:text-on-dark-muted flex-wrap pt-1">
            <span class="flex items-center gap-1.5">
              <Layers class="w-4 h-4 text-stone dark:text-on-dark-muted" />
              <a href={`/trades/${resource.trade_slug}/subjects/${resource.subject_slug}`} class="hover:underline text-ink dark:text-on-dark font-medium">
                {resource.subject_name}
              </a>
            </span>
            <span class="flex items-center gap-1.5">
              <Calendar class="w-4 h-4 text-stone dark:text-on-dark-muted" />
              Published: {pubDate}
            </span>
            {resource.author_name && (
              <span class="flex items-center gap-1.5">
                <User class="w-4 h-4 text-stone dark:text-on-dark-muted" />
                {resource.author_name}
              </span>
            )}
          </div>
        </div>

        <!-- Document Preview Window (Mintlify-style Elevation) -->
        <div class="rounded-xl border border-hairline dark:border-hairline-dark bg-canvas dark:bg-surface-code overflow-hidden shadow-sm">
          <div class="px-4 py-3 bg-surface-soft dark:bg-canvas-dark/60 border-b border-hairline dark:border-hairline-dark flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Eye class="w-4 h-4 text-brand-green-deep dark:text-brand-green" />
              <span class="text-xs font-semibold text-ink dark:text-on-dark">Document Preview</span>
              {primaryFile && (
                <span class="text-[11px] font-mono text-stone dark:text-on-dark-muted">
                  ({primaryFile.original_filename})
                </span>
              )}
            </div>

            {primaryFile && (
              <a
                href={primaryFile.download_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-ink dark:text-on-dark hover:text-brand-green-deep dark:hover:text-brand-green font-medium flex items-center gap-1"
              >
                <span>Full screen</span>
                <ExternalLink class="w-3.5 h-3.5" />
              </a>
            )}
          </div>

          <div class="p-2 sm:p-4 bg-surface/50 dark:bg-canvas-dark/50 min-h-[420px] flex items-center justify-center">
            {isPdf && primaryFile ? (
              <iframe
                src={primaryFile.download_url}
                title={`Preview of ${resource.title}`}
                class="w-full h-[520px] rounded-lg border border-hairline dark:border-hairline-dark bg-canvas dark:bg-canvas-dark shadow-xs"
              />
            ) : isSvgOrImage && primaryFile ? (
              <div class="p-4 bg-canvas dark:bg-canvas-dark rounded-lg border border-hairline dark:border-hairline-dark w-full text-center">
                <img
                  src={primaryFile.download_url}
                  alt={`Diagram for ${resource.title}`}
                  class="max-h-[500px] mx-auto rounded object-contain"
                />
              </div>
            ) : (
              <div class="text-center p-8 bg-canvas dark:bg-canvas-dark rounded-lg border border-hairline dark:border-hairline-dark max-w-md">
                <FileText class="w-12 h-12 text-stone dark:text-on-dark-muted mx-auto mb-3" />
                <h3 class="text-sm font-semibold text-ink dark:text-on-dark mb-1">Standard File Format</h3>
                <p class="text-xs text-steel dark:text-on-dark-muted mb-4">
                  This resource is provided as an editable <strong>DOCX/Office</strong> template. You can download and open it in any word processing suite.
                </p>
                {primaryFile && (
                  <a
                    href={primaryFile.download_url}
                    download={primaryFile.original_filename}
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary dark:bg-brand-green text-on-primary dark:text-primary rounded-full text-xs font-semibold hover:bg-charcoal dark:hover:bg-brand-green-deep transition-colors"
                  >
                    <Download class="w-4 h-4 text-brand-green dark:text-primary" />
                    <span>Download {primaryFile.original_filename}</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>

        <!-- Detailed Description -->
        <div class="p-6 rounded-xl border border-hairline dark:border-hairline-dark bg-canvas dark:bg-surface-code space-y-4">
          <h2 class="text-lg font-bold text-ink dark:text-on-dark">Instructional Objectives &amp; Overview</h2>
          <div class="text-sm text-charcoal dark:text-on-dark leading-relaxed space-y-3">
            <p>{resource.description}</p>
            <p class="text-xs text-steel dark:text-on-dark-muted">
              This document is prepared to meet the instructional sequence mandated by the NIMI instructional framework for trade testing and formative assessment in industrial training institutes.
            </p>
          </div>

          <!-- Tags -->
          {resource.tags && resource.tags.length > 0 && (
            <div class="pt-4 border-t border-hairline-soft dark:border-hairline-dark">
              <span class="text-xs font-semibold text-ink dark:text-on-dark block mb-2">Curriculum Topics &amp; Competencies:</span>
              <div class="flex items-center gap-1.5 flex-wrap">
                {resource.tags.map((tag) => (
                  <a
                    href={`/library?q=${encodeURIComponent(tag)}`}
                    class="text-xs px-2.5 py-1 bg-surface dark:bg-canvas-dark hover:bg-hairline-soft dark:hover:bg-surface border border-hairline dark:border-hairline-dark rounded text-charcoal dark:text-on-dark transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>

      <!-- Right Column: Download Card, File Attachments, Metadata & Governance -->
      <aside class="space-y-6">
        
        <!-- Primary Action / Download Card -->
        <div class="p-6 rounded-xl border-2 border-brand-green bg-canvas dark:bg-surface-code shadow-xs space-y-4">
          <h2 class="text-base font-bold text-ink dark:text-on-dark flex items-center justify-between">
            <span>Download Resource</span>
            <span class="text-xs font-normal text-brand-green-deep dark:text-brand-green">Free &amp; Open Access</span>
          </h2>

          <p class="text-xs text-steel dark:text-on-dark-muted">
            No registration or login required. Download the verified instructional file directly.
          </p>

          {primaryFile && (
            <a
              href={primaryFile.download_url}
              download={primaryFile.original_filename}
              class="w-full py-3 px-4 bg-primary dark:bg-brand-green hover:bg-charcoal dark:hover:bg-brand-green-deep text-on-primary dark:text-primary rounded-full text-sm font-semibold text-center transition-colors flex items-center justify-center gap-2 shadow-sm"
            >
              <Download class="w-4 h-4 text-brand-green dark:text-primary" />
              <span>Download Primary ({primaryFile.original_filename.split('.').pop()?.toUpperCase()})</span>
            </a>
          )}

          <!-- Additional Attachments (e.g. DOCX version if PDF is primary) -->
          {otherFiles.length > 0 && (
            <div class="pt-3 border-t border-hairline-soft dark:border-hairline-dark space-y-2">
              <span class="text-xs font-semibold text-ink dark:text-on-dark block">Alternative Formats:</span>
              {otherFiles.map((f) => (
                <a
                  href={f.download_url}
                  download={f.original_filename}
                  class="w-full py-2 px-3 bg-surface dark:bg-canvas-dark hover:bg-hairline-soft dark:hover:bg-surface border border-hairline dark:border-hairline-dark rounded-lg text-xs font-medium text-charcoal dark:text-on-dark transition-colors flex items-center justify-between"
                >
                  <span class="truncate">{f.original_filename}</span>
                  <Download class="w-3.5 h-3.5 text-steel dark:text-on-dark-muted flex-shrink-0 ml-2" />
                </a>
              ))}
            </div>
          )}

          <div class="text-[11px] text-stone dark:text-on-dark-muted pt-2 flex items-center gap-1.5">
            <ShieldCheck class="w-3.5 h-3.5 text-brand-green-deep dark:text-brand-green" />
            <span>Integrity Verified • Safe Direct Download</span>
          </div>
        </div>

        <!-- Technical Metadata Card -->
        <div class="p-6 rounded-xl border border-hairline dark:border-hairline-dark bg-canvas dark:bg-surface-code space-y-3 text-xs">
          <h3 class="text-xs font-bold text-ink dark:text-on-dark uppercase tracking-wider pb-2 border-b border-hairline-soft dark:border-hairline-dark">
            Resource Specifications
          </h3>

          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Trade:</span>
              <a href={`/trades/${resource.trade_slug}`} class="font-medium text-ink dark:text-on-dark hover:underline">
                {resource.trade_name}
              </a>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Subject:</span>
              <span class="font-medium text-ink dark:text-on-dark text-right truncate max-w-[180px]">
                {resource.subject_name}
              </span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Training Level:</span>
              <span class="font-medium text-ink dark:text-on-dark">Year {resource.training_year}</span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Language:</span>
              <span class="font-medium text-ink dark:text-on-dark">{resource.language}</span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Version:</span>
              <span class="font-mono text-ink dark:text-on-dark">{resource.version_label}</span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone dark:text-on-dark-muted">Last Updated:</span>
              <span class="font-medium text-ink dark:text-on-dark">{updDate}</span>
            </div>

            {resource.source_name && (
              <div class="pt-2 border-t border-hairline-soft dark:border-hairline-dark">
                <span class="text-stone dark:text-on-dark-muted block mb-0.5">Issuing / Reference Framework:</span>
                <span class="font-medium text-ink dark:text-on-dark">{resource.source_name}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Content Correction Notice -->
        <div class="p-5 rounded-xl border border-hairline dark:border-hairline-dark bg-surface-soft dark:bg-surface-code/60 text-xs text-steel dark:text-on-dark-muted space-y-2">
          <div class="flex items-center gap-1.5 font-semibold text-ink dark:text-on-dark">
            <HelpCircle class="w-4 h-4 text-stone dark:text-on-dark-muted" />
            <span>Content Correction Procedure</span>
          </div>
          <p class="leading-relaxed">
            Spot a technical error, outdated diagram, or missing step? Instructors are encouraged to submit a correction request.
          </p>
          <a href="/contact" class="text-brand-green-deep dark:text-brand-green font-medium hover:underline inline-block pt-1">
            Submit a correction notice →
          </a>
        </div>

      </aside>

    </div>

    <!-- Related Resources -->
    {relatedResources.length > 0 && (
      <section class="mt-16 pt-12 border-t border-hairline dark:border-hairline-dark">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-ink dark:text-on-dark">Related Teaching Resources</h2>
          <p class="text-xs text-steel dark:text-on-dark-muted mt-0.5">Explore corresponding practical guides and study notes in {resource.trade_name}.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedResources.map((res) => (
            <ResourceCard resource={res} />
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
