---
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import ResourceCard from '../../../../components/resources/ResourceCard.astro';
import { getAllSubjects, getSubjectBySlug } from '../../../../lib/data/subjects';
import { getTradeBySlug } from '../../../../lib/data/trades';
import { getResourcesBySubject } from '../../../../lib/data/resources';
import { BookOpen, Layers, ArrowRight, ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const subjects = getAllSubjects();
  return subjects.map((subject) => ({
    params: {
      tradeSlug: subject.trade_slug || 'ictsm',
      subjectSlug: subject.slug,
    },
    props: { subject },
  }));
}

const { tradeSlug, subjectSlug } = Astro.params;
const { subject } = Astro.props;
const trade = getTradeBySlug(tradeSlug as string);
const resources = getResourcesBySubject(tradeSlug as string, subjectSlug as string);
---

<Layout
  title={`${subject.name} - ${trade?.name || 'Trade'} Resources`}
  description={subject.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <Breadcrumbs
      items={[
        { label: 'Trades', href: '/trades' },
        { label: trade?.name || 'Trade', href: `/trades/${tradeSlug}` },
        { label: subject.name },
      ]}
    />

    <!-- Subject Header -->
    <div class="mt-4 mb-10 p-6 sm:p-8 rounded-2xl bg-canvas dark:bg-surface-code border border-hairline dark:border-hairline-dark shadow-xs">
      <div class="flex items-center gap-2 mb-2">
        <a
          href={`/trades/${tradeSlug}`}
          class="text-xs text-steel dark:text-on-dark-muted hover:text-ink dark:hover:text-on-dark inline-flex items-center gap-1 font-medium"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Back to {trade?.name || 'Trade'}</span>
        </a>
      </div>

      <div class="flex items-center gap-2 flex-wrap mb-2">
        <span class="text-xs font-mono font-medium px-2 py-0.5 bg-surface dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded text-steel dark:text-on-dark-muted">
          {subject.code}
        </span>
        <span class="text-xs font-semibold px-2 py-0.5 bg-brand-green/15 text-brand-green-deep dark:text-brand-green rounded-full border border-brand-green/30">
          Year {subject.training_year} (Semester {subject.semester})
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-ink dark:text-on-dark tracking-tight">
        {subject.name}
      </h1>

      <p class="text-sm text-steel dark:text-on-dark-muted mt-2 max-w-3xl leading-relaxed">
        {subject.description}
      </p>
    </div>

    <!-- Subject Resources Section -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-ink dark:text-on-dark">Subject Resources ({resources.length})</h2>
          <p class="text-xs text-steel dark:text-on-dark-muted mt-0.5">Lesson plans, practical job sheets, and study materials for this curriculum unit.</p>
        </div>
        <a
          href={`/library?trade=${tradeSlug}&subject=${subjectSlug}`}
          class="text-xs font-semibold text-ink dark:text-on-dark hover:text-brand-green-deep dark:hover:text-brand-green flex items-center gap-1"
        >
          <span>Search with filters</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      {resources.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {resources.map((res) => (
            <ResourceCard resource={res} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center bg-surface-soft dark:bg-surface-code/50 rounded-xl border border-dashed border-hairline dark:border-hairline-dark">
          <BookOpen class="w-8 h-8 text-stone dark:text-on-dark-muted mx-auto mb-3" />
          <h3 class="text-sm font-semibold text-ink dark:text-on-dark mb-1">No resources found for this specific subject yet</h3>
          <p class="text-xs text-steel dark:text-on-dark-muted max-w-sm mx-auto mb-4">
            Instructors are currently preparing lesson plans for this module. You can check the complete trade library.
          </p>
          <a
            href={`/trades/${tradeSlug}`}
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary dark:bg-brand-green text-on-primary dark:text-primary text-xs font-semibold rounded-full hover:bg-charcoal dark:hover:bg-brand-green-deep transition-colors"
          >
            <span>View other subjects in {trade?.name}</span>
          </a>
        </div>
      )}
    </section>

  </div>
</Layout>
