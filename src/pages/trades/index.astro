---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getActiveTrades } from '../../lib/data/trades';
import { getSubjectsByTrade } from '../../lib/data/subjects';
import { getTradeResourceCount } from '../../lib/data/resources';
import { Cpu, Zap, Wrench, Terminal, ArrowRight, BookOpen, Layers } from 'lucide-astro';

const trades = getActiveTrades();

const iconMap: Record<string, any> = {
  cpu: Cpu,
  zap: Zap,
  wrench: Wrench,
  terminal: Terminal,
};
---

<Layout
  title="Trades Directory - ITI CTS Vocational Courses"
  description="Explore all active Craftsmen Training Scheme (CTS) vocational trades including ICTSM, Electrician, Fitter, and COPA."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <Breadcrumbs items={[{ label: 'Trades Directory' }]} />

    <div class="mt-4 mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-brand-green-deep dark:text-brand-green">Craftsmen Training Scheme</span>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink dark:text-on-dark mt-1">ITI Trades Directory</h1>
      <p class="text-sm text-steel dark:text-on-dark-muted mt-2 max-w-2xl leading-relaxed">
        Select a trade to view its specialized subjects, theoretical curriculum, workshop demonstration guides, and downloadable training resources.
      </p>
    </div>

    <!-- Trades Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {trades.map((trade) => {
        const IconComp = iconMap[trade.icon] || Cpu;
        const subjects = getSubjectsByTrade(trade.id);
        const resourceCount = getTradeResourceCount(trade.id);
        const isPrimary = trade.slug === '';

        return (
          <div class="flex flex-col justify-between p-6 sm:p-8 bg-canvas dark:bg-surface-code border border-brand-green/50 dark:border-hairline-dark rounded-xl ring-1 ring-brand-green/20 transition-all hover:border-brand-green-deep hover:shadow-sm">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                  <div class={`w-12 h-12 rounded-xl ${isPrimary ? 'bg-primary dark:bg-canvas-dark text-on-primary' : 'bg-surface dark:bg-canvas-dark text-ink dark:text-on-dark'} flex items-center justify-center border border-hairline dark:border-hairline-dark`}>
                    <IconComp class={`w-6 h-6 ${isPrimary ? 'text-brand-green' : 'text-steel dark:text-on-dark-muted'}`} />
                  </div>
                  <div>
                    <h2 class="text-lg font-bold text-ink dark:text-on-dark leading-tight">
                      <a href={`/trades/${trade.slug}`} class="hover:text-brand-green-deep dark:hover:text-brand-green transition-colors focus:outline-none focus:underline">
                        {trade.name}
                      </a>
                    </h2>
                    <span class="font-mono text-xs text-stone dark:text-on-dark-muted">
                      Code: {trade.code} • {trade.duration_years} Year Program
                    </span>
                  </div>
                </div>

                {isPrimary && (
                  <span class="px-2.5 py-1 text-[11px] font-semibold bg-brand-green/15 text-brand-green-deep dark:text-brand-green rounded-full border border-brand-green/30 uppercase tracking-wider">
                    Primary Trade
                  </span>
                )}
              </div>

              <p class="text-sm text-steel dark:text-on-dark-muted leading-relaxed mb-6">
                {trade.description}
              </p>

              <!-- Subjects Preview -->
              <div class="mb-6">
                <h3 class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider mb-2 flex items-center gap-1.5">
                  <Layers class="w-3.5 h-3.5 text-stone dark:text-on-dark-muted" />
                  <span>Key Subjects &amp; Practical Modules ({subjects.length})</span>
                </h3>
                <div class="flex flex-wrap gap-1.5">
                  {subjects.map((sub) => (
                    <a
                      href={`/trades/${trade.slug}/subjects/${sub.slug}`}
                      class="text-xs px-2.5 py-1 bg-surface dark:bg-canvas-dark hover:bg-hairline-soft dark:hover:bg-surface border border-hairline dark:border-hairline-dark rounded-md text-charcoal dark:text-on-dark transition-colors"
                    >
                      {sub.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <!-- Footer Meta & CTA -->
            <div class="pt-5 border-t border-hairline-soft dark:border-hairline-dark flex items-center justify-between">
              <span class="text-xs font-medium text-steel dark:text-on-dark-muted flex items-center gap-1.5">
                <BookOpen class="w-4 h-4 text-stone dark:text-on-dark-muted" />
                <span>{resourceCount} Published Teaching Resources</span>
              </span>

              <a
                href={`/trades/${trade.slug}`}
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary dark:bg-brand-green hover:bg-charcoal dark:hover:bg-brand-green-deep text-on-primary dark:text-primary rounded-full text-xs font-semibold transition-colors"
              >
                <span>View Trade Portal</span>
                <ArrowRight class="w-3.5 h-3.5 text-brand-green dark:text-primary" />
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</Layout>
