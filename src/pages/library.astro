---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/resources/ResourceCard.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { searchResources } from '../lib/data/resources';
import { getActiveTrades } from '../lib/data/trades';
import { getAllSubjects } from '../lib/data/subjects';
import { RESOURCE_CATEGORIES } from '../lib/data/categories';
import {
  Search,
  Filter,
  X,
  SlidersHorizontal,
  ChevronLeft,
  ChevronRight,
  RotateCcw,
  BookOpen,
  FileQuestion,
} from 'lucide-astro';

// Parse Query Parameters from URL
const searchParams = Astro.url.searchParams;
const query = searchParams.get('q') || '';
const trade = searchParams.get('trade') || 'all';
const subject = searchParams.get('subject') || 'all';
const resourceType = searchParams.get('type') || 'all';
const year = searchParams.get('year') || 'all';
const format = searchParams.get('format') || 'all';
const sort = (searchParams.get('sort') as 'relevance' | 'newest' | 'alphabetical') || 'relevance';
const page = parseInt(searchParams.get('page') || '1', 10);
const limit = 9;

// Execute real search
const searchResult = searchResources({
  query,
  trade,
  subject,
  resource_type: resourceType,
  year,
  format,
  sort,
  page,
  limit,
});

const trades = getActiveTrades();
const allSubjects = getAllSubjects();
const filteredSubjects = trade !== 'all' ? allSubjects.filter((s) => s.trade_slug === trade) : allSubjects;

// Helper to construct pagination and filter URLs
function buildUrl(overrides: Record<string, string | number>) {
  const params = new URLSearchParams(searchParams);
  Object.entries(overrides).forEach(([key, val]) => {
    if (val === 'all' || val === '' || val === undefined) {
      params.delete(key);
    } else {
      params.set(key, String(val));
    }
  });
  return `/library?${params.toString()}`;
}

const hasActiveFilters = Boolean(
  query || trade !== 'all' || subject !== 'all' || resourceType !== 'all' || year !== 'all' || format !== 'all' || sort !== 'relevance'
);
---

<Layout
  title="Resource Library - Search Lesson Plans, Lab Manuals & Notes"
  description="Search and filter standardized ITI training materials. Download lesson plans, demonstration guides, lab manuals, and diagrams."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    
    <Breadcrumbs items={[{ label: 'Resource Library' }]} />

    <!-- Page Header & Global Search Bar -->
    <div class="mt-4 mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#00b48a]">Searchable Catalog</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0a0a0a] mt-1">Resource Library</h1>
          <p class="text-sm text-[#5a5a5c] mt-1">
            Access {searchResult.total} verified teaching and practical resources. Filter by trade, year, category, and file format.
          </p>
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-2 self-start md:self-auto">
          <label for="sort-select" class="text-xs font-medium text-[#5a5a5c]">Sort by:</label>
          <select
            id="sort-select"
            class="text-xs font-medium bg-white border border-[#e5e5e5] rounded-lg px-3 py-1.5 text-[#0a0a0a] focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
            onchange="window.location.href = this.value"
          >
            <option value={buildUrl({ sort: 'relevance', page: 1 })} selected={sort === 'relevance'}>Relevance / Featured</option>
            <option value={buildUrl({ sort: 'newest', page: 1 })} selected={sort === 'newest'}>Newest First</option>
            <option value={buildUrl({ sort: 'alphabetical', page: 1 })} selected={sort === 'alphabetical'}>Alphabetical (A-Z)</option>
          </select>
        </div>
      </div>

      <!-- Main Search Box -->
      <form action="/library" method="GET" class="relative flex items-center">
        <!-- Preserve existing filters -->
        {trade !== 'all' && <input type="hidden" name="trade" value={trade} />}
        {subject !== 'all' && <input type="hidden" name="subject" value={subject} />}
        {resourceType !== 'all' && <input type="hidden" name="type" value={resourceType} />}
        {year !== 'all' && <input type="hidden" name="year" value={year} />}
        {format !== 'all' && <input type="hidden" name="format" value={format} />}
        {sort !== 'relevance' && <input type="hidden" name="sort" value={sort} />}

        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[#888888]">
          <Search class="w-5 h-5" />
        </div>
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search by topic, keyword, syllabus title, or author (e.g. Subnetting, Motherboard, Fiber, Cat6)..."
          class="w-full pl-12 pr-28 py-3.5 bg-white rounded-xl border border-[#e5e5e5] focus:outline-none focus:ring-2 focus:ring-[#00d4a4] focus:border-transparent text-sm text-[#0a0a0a] shadow-sm"
        />
        <button
          type="submit"
          class="absolute right-2 top-2 bottom-2 px-5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-lg text-xs font-medium transition-colors"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Active Filter Chips Bar -->
    {hasActiveFilters && (
      <div class="mb-6 p-3 bg-[#fafafa] border border-[#ededed] rounded-xl flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap text-xs">
          <span class="text-[#888888] font-medium">Active Filters:</span>
          {query && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-[#e5e5e5] rounded-full text-[#1c1c1e]">
              Query: "{query}"
              <a href={buildUrl({ q: '', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {trade !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-[#e5e5e5] rounded-full text-[#1c1c1e]">
              Trade: {trade.toUpperCase()}
              <a href={buildUrl({ trade: 'all', subject: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {resourceType !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-[#e5e5e5] rounded-full text-[#1c1c1e]">
              Type: {resourceType}
              <a href={buildUrl({ type: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {year !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-[#e5e5e5] rounded-full text-[#1c1c1e]">
              Year: {year}
              <a href={buildUrl({ year: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {format !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-[#e5e5e5] rounded-full text-[#1c1c1e]">
              Format: {format.toUpperCase()}
              <a href={buildUrl({ format: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
        </div>

        <a
          href="/library"
          class="text-xs font-semibold text-red-600 hover:text-red-700 inline-flex items-center gap-1"
        >
          <RotateCcw class="w-3 h-3" />
          <span>Clear all</span>
        </a>
      </div>
    )}

    <!-- Layout: Filters Sidebar + Results Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Filters Sidebar (Desktop) -->
      <aside class="hidden lg:block space-y-6">
        <div class="bg-white rounded-xl border border-[#e5e5e5] p-5 space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#ededed]">
            <h2 class="text-sm font-bold text-[#0a0a0a] flex items-center gap-2">
              <SlidersHorizontal class="w-4 h-4 text-[#00b48a]" />
              <span>Filters</span>
            </h2>
            {hasActiveFilters && (
              <a href="/library" class="text-xs text-[#888888] hover:text-[#0a0a0a] underline">Reset</a>
            )}
          </div>

          <!-- Filter: Trade -->
          <div class="space-y-2">
            <label class="text-xs font-semibold text-[#0a0a0a] uppercase tracking-wider block">Trade</label>
            <div class="space-y-1">
              <a
                href={buildUrl({ trade: 'all', subject: 'all', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  trade === 'all' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                All Trades
              </a>
              {trades.map((t) => (
                <a
                  href={buildUrl({ trade: t.slug, subject: 'all', page: 1 })}
                  class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                    trade === t.slug ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                  }`}
                >
                  {t.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Filter: Resource Type -->
          <div class="space-y-2 pt-2 border-t border-[#ededed]">
            <label class="text-xs font-semibold text-[#0a0a0a] uppercase tracking-wider block">Resource Type</label>
            <div class="space-y-1">
              <a
                href={buildUrl({ type: 'all', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'all' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                All Types
              </a>
              <a
                href={buildUrl({ type: 'lesson-plan', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'lesson-plan' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                Lesson Plans
              </a>
              <a
                href={buildUrl({ type: 'demonstration-plan', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'demonstration-plan' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                Demonstration Plans
              </a>
              <a
                href={buildUrl({ type: 'lab-manual', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'lab-manual' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                Lab Manuals &amp; Job Sheets
              </a>
              <a
                href={buildUrl({ type: 'notes', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'notes' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                Subject Notes &amp; Handouts
              </a>
              <a
                href={buildUrl({ type: 'diagram', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'diagram' ? 'bg-[#0a0a0a] text-white font-medium' : 'text-[#5a5a5c] hover:bg-[#f7f7f7]'
                }`}
              >
                Technical Diagrams
              </a>
            </div>
          </div>

          <!-- Filter: Training Year -->
          <div class="space-y-2 pt-2 border-t border-[#ededed]">
            <label class="text-xs font-semibold text-[#0a0a0a] uppercase tracking-wider block">Training Year</label>
            <div class="flex items-center gap-2">
              <a
                href={buildUrl({ year: 'all', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === 'all' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                All
              </a>
              <a
                href={buildUrl({ year: '1', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === '1' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                Year 1
              </a>
              <a
                href={buildUrl({ year: '2', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === '2' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                Year 2
              </a>
            </div>
          </div>

          <!-- Filter: File Format -->
          <div class="space-y-2 pt-2 border-t border-[#ededed]">
            <label class="text-xs font-semibold text-[#0a0a0a] uppercase tracking-wider block">File Format</label>
            <div class="grid grid-cols-2 gap-2">
              <a
                href={buildUrl({ format: 'all', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'all' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                All
              </a>
              <a
                href={buildUrl({ format: 'pdf', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'pdf' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                PDF
              </a>
              <a
                href={buildUrl({ format: 'docx', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'docx' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                DOCX
              </a>
              <a
                href={buildUrl({ format: 'svg', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'svg' ? 'bg-[#0a0a0a] text-white font-medium' : 'bg-[#f7f7f7] text-[#5a5a5c] hover:bg-[#ededed]'
                }`}
              >
                SVG/Image
              </a>
            </div>
          </div>

        </div>
      </aside>

      <!-- Main Results Area -->
      <section class="lg:col-span-3">
        <!-- Results Summary Bar -->
        <div class="flex items-center justify-between mb-4 text-xs text-[#5a5a5c]">
          <span>
            Showing <strong>{searchResult.items.length}</strong> of <strong>{searchResult.total}</strong> published resources
          </span>
          <span class="text-[11px] text-[#888888]">Page {searchResult.page} of {Math.max(1, searchResult.totalPages)}</span>
        </div>

        <!-- Resource Cards Grid -->
        {searchResult.items.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {searchResult.items.map((res) => (
              <ResourceCard resource={res} />
            ))}
          </div>
        ) : (
          <div class="rounded-xl border border-dashed border-[#e5e5e5] p-12 text-center bg-[#fafafa]">
            <div class="w-12 h-12 rounded-full bg-white border border-[#e5e5e5] flex items-center justify-center mx-auto mb-4 text-[#888888]">
              <FileQuestion class="w-6 h-6" />
            </div>
            <h3 class="text-base font-semibold text-[#0a0a0a] mb-1">No matching resources found</h3>
            <p class="text-xs text-[#5a5a5c] max-w-sm mx-auto mb-6">
              Try adjusting your search terms, removing active filters, or selecting "All Trades".
            </p>
            <a
              href="/library"
              class="inline-flex items-center gap-2 px-5 py-2 bg-[#0a0a0a] text-white text-xs font-medium rounded-full hover:bg-[#1c1c1e] transition-colors"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Reset all filters</span>
            </a>
          </div>
        )}

        <!-- Pagination Controls -->
        {searchResult.totalPages > 1 && (
          <div class="mt-10 pt-6 border-t border-[#ededed] flex items-center justify-between">
            <div>
              {searchResult.page > 1 ? (
                <a
                  href={buildUrl({ page: searchResult.page - 1 })}
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-[#e5e5e5] hover:bg-[#f7f7f7] rounded-lg text-xs font-medium text-[#0a0a0a] transition-colors"
                >
                  <ChevronLeft class="w-4 h-4" />
                  <span>Previous</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#f7f7f7] border border-[#e5e5e5] rounded-lg text-xs font-medium text-[#a8a8aa] cursor-not-allowed">
                  <ChevronLeft class="w-4 h-4" />
                  <span>Previous</span>
                </span>
              )}
            </div>

            <!-- Page Number Indicators -->
            <div class="flex items-center gap-1 text-xs">
              {Array.from({ length: searchResult.totalPages }, (_, i) => i + 1).map((p) => (
                <a
                  href={buildUrl({ page: p })}
                  class={`w-8 h-8 flex items-center justify-center rounded-lg transition-colors ${
                    p === searchResult.page
                      ? 'bg-[#0a0a0a] text-white font-semibold'
                      : 'bg-white border border-[#e5e5e5] text-[#5a5a5c] hover:bg-[#f7f7f7]'
                  }`}
                >
                  {p}
                </a>
              ))}
            </div>

            <div>
              {searchResult.hasMore ? (
                <a
                  href={buildUrl({ page: searchResult.page + 1 })}
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-[#e5e5e5] hover:bg-[#f7f7f7] rounded-lg text-xs font-medium text-[#0a0a0a] transition-colors"
                >
                  <span>Next</span>
                  <ChevronRight class="w-4 h-4" />
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#f7f7f7] border border-[#e5e5e5] rounded-lg text-xs font-medium text-[#a8a8aa] cursor-not-allowed">
                  <span>Next</span>
                  <ChevronRight class="w-4 h-4" />
                </span>
              )}
            </div>
          </div>
        )}

      </section>

    </div>

  </div>
</Layout>
