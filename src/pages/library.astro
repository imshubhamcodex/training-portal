---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/resources/ResourceCard.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SearchBox from '../components/ui/SearchBox.astro';
import { searchResources } from '../lib/data/resources';
import { getActiveTrades } from '../lib/data/trades';
import { getAllSubjects } from '../lib/data/subjects';
import { RESOURCE_CATEGORIES } from '../lib/data/categories';
import {
  X,
  SlidersHorizontal,
  ChevronLeft,
  ChevronRight,
  RotateCcw,
  BookOpen,
  FileQuestion,
} from 'lucide-astro';

export const prerender = false;

// Parse Query Parameters from URL
const url = new URL(Astro.request.url);
const searchParams = url.searchParams;
const query = searchParams.get('q') || '';
const trade = searchParams.get('trade') || 'all';
const subject = searchParams.get('subject') || 'all';
const resourceType = searchParams.get('type') || 'all';
const year = searchParams.get('year') || 'all';
const week = searchParams.get('week') || 'all';
const format = searchParams.get('format') || 'all';
const sort = (searchParams.get('sort') as 'relevance' | 'newest' | 'alphabetical') || 'relevance';
const page = parseInt(searchParams.get('page') || '1', 10);
const limit = 9;

// Execute real search
const searchResult = searchResources({
  query,
  trade,
  subject,
  resource_type: resourceType,
  year,
  week,
  format,
  sort,
  page,
  limit,
});

const trades = getActiveTrades();
const allSubjects = getAllSubjects();
const filteredSubjects = trade !== 'all' ? allSubjects.filter((s) => s.trade_slug === trade) : allSubjects;

// Helper to construct pagination and filter URLs
function buildUrl(overrides: Record<string, string | number>) {
  const params = new URLSearchParams(searchParams);
  Object.entries(overrides).forEach(([key, val]) => {
    if (val === 'all' || val === '' || val === undefined) {
      params.delete(key);
    } else {
      params.set(key, String(val));
    }
  });
  return `/library?${params.toString()}`;
}

const hasActiveFilters = Boolean(
  query || trade !== 'all' || subject !== 'all' || resourceType !== 'all' || year !== 'all' || format !== 'all' || sort !== 'relevance'
);
---

<Layout
  title="Resource Library - Search Lesson Plans, Lab Manuals & Notes"
  description="Search and filter standardized ITI training materials. Download lesson plans, demonstration guides, lab manuals, and diagrams."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    
    <Breadcrumbs items={[{ label: 'Resource Library' }]} />

    <!-- Page Header & Global Search Bar -->
    <div class="mt-4 mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-green-deep">Searchable Catalog</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink dark:text-on-dark mt-1">Resource Library</h1>
          <p class="text-sm text-steel dark:text-on-dark-muted mt-1">
            Access {searchResult.total} verified teaching and practical resources. Filter by trade, year, category, and file format.
          </p>
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-2 self-start md:self-auto">
          <label for="sort-select" class="text-xs font-medium text-steel dark:text-on-dark-muted">Sort by:</label>
          <select
            id="sort-select"
            class="text-xs font-medium bg-canvas dark:bg-surface-code border border-hairline dark:border-hairline-dark rounded-full px-3 py-1.5 text-ink dark:text-on-dark focus:outline-none focus:ring-2 focus:ring-brand-green"
            onchange="window.location.href = this.value"
          >
            <option value={buildUrl({ sort: 'relevance', page: 1 })} selected={sort === 'relevance'}>Relevance / Featured</option>
            <option value={buildUrl({ sort: 'newest', page: 1 })} selected={sort === 'newest'}>Newest First</option>
            <option value={buildUrl({ sort: 'alphabetical', page: 1 })} selected={sort === 'alphabetical'}>Alphabetical (A-Z)</option>
          </select>
        </div>
      </div>

      <!-- Main Search Box with Live Autocomplete -->
      <SearchBox
        id="library-search"
        defaultValue={query}
        placeholder="Search by topic, keyword, syllabus title, or author (e.g. Subnetting, Motherboard, Fiber, Cat6)..."
        action="/library"
        size="default"
        preserveParams={{ trade, subject, type: resourceType, year, format, sort }}
      />
    </div>

    <!-- Active Filter Chips Bar -->
    {hasActiveFilters && (
      <div class="mb-6 p-3 bg-surface-soft dark:bg-surface-code/80 border border-hairline-soft dark:border-hairline-dark rounded-xl flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap text-xs">
          <span class="text-stone dark:text-on-dark-muted font-medium">Active Filters:</span>
          {query && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark">
              Query: "{query}"
              <a href={buildUrl({ q: '', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {trade !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark">
              Trade: {trade.toUpperCase()}
              <a href={buildUrl({ trade: 'all', subject: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {resourceType !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark">
              Type: {resourceType}
              <a href={buildUrl({ type: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {year !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark">
              Year: {year}
              <a href={buildUrl({ year: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
          {format !== 'all' && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark rounded-full text-charcoal dark:text-on-dark">
              Format: {format.toUpperCase()}
              <a href={buildUrl({ format: 'all', page: 1 })} class="hover:text-red-500"><X class="w-3 h-3" /></a>
            </span>
          )}
        </div>

        <a
          href="/library"
          class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline inline-flex items-center gap-1"
        >
          <RotateCcw class="w-3 h-3" />
          <span>Clear all</span>
        </a>
      </div>
    )}

    <!-- Layout: Filters Sidebar + Results Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Filters Sidebar (Desktop) -->
      <aside class="hidden lg:block space-y-6">
        <div class="bg-canvas dark:bg-surface-code rounded-xl border border-hairline dark:border-hairline-dark p-5 space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-hairline-soft dark:border-hairline-dark">
            <h2 class="text-sm font-bold text-ink dark:text-on-dark flex items-center gap-2">
              <SlidersHorizontal class="w-4 h-4 text-brand-green-deep dark:text-brand-green" />
              <span>Filters</span>
            </h2>
            {hasActiveFilters && (
              <a href="/library" class="text-xs text-stone dark:text-on-dark-muted hover:text-ink dark:hover:text-on-dark underline">Reset</a>
            )}
          </div>

          <!-- Filter: Trade -->
          <div class="space-y-2">
            <label class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider block">Trade</label>
            <div class="space-y-1">
              <a
                href={buildUrl({ trade: 'all', subject: 'all', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  trade === 'all'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                All Trades
              </a>
              {trades.map((t) => (
                <a
                  href={buildUrl({ trade: t.slug, subject: 'all', page: 1 })}
                  class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                    trade === t.slug
                      ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                      : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                  }`}
                >
                  {t.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Filter: Resource Type -->
          <div class="space-y-2 pt-2 border-t border-hairline-soft dark:border-hairline-dark">
            <label class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider block">Resource Type</label>
            <div class="space-y-1">
              <a
                href={buildUrl({ type: 'all', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'all'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                All Types
              </a>
              <a
                href={buildUrl({ type: 'lesson-plan', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'lesson-plan'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                Lesson Plans
              </a>
              <a
                href={buildUrl({ type: 'demonstration-plan', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'demonstration-plan'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                Demonstration Plans
              </a>
              <a
                href={buildUrl({ type: 'lab-manual', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'lab-manual'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                Lab Manuals &amp; Job Sheets
              </a>
              <a
                href={buildUrl({ type: 'notes', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'notes'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                Subject Notes &amp; Handouts
              </a>
              <a
                href={buildUrl({ type: 'diagram', page: 1 })}
                class={`block px-3 py-1.5 text-xs rounded-md transition-colors ${
                  resourceType === 'diagram'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                Technical Diagrams
              </a>
            </div>
          </div>

          <!-- Filter: Training Year -->
          <div class="space-y-2 pt-2 border-t border-hairline-soft dark:border-hairline-dark">
            <label class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider block">Training Year</label>
            <div class="flex items-center gap-2">
              <a
                href={buildUrl({ year: 'all', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === 'all'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                All
              </a>
              <a
                href={buildUrl({ year: '1', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === '1'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                Year 1
              </a>
              <a
                href={buildUrl({ year: '2', page: 1 })}
                class={`px-3 py-1.5 text-xs rounded-md text-center flex-1 transition-colors ${
                  year === '2'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                Year 2
              </a>
            </div>
          </div>

          <!-- Filter: Week Number -->
          <div class="space-y-2 pt-2 border-t border-hairline-soft dark:border-hairline-dark">
            <label class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider block">Week Number: <span id="week-label">{week === 'all' ? 'All' : week}</span></label>
            <input
              id="week-slider"
              type="range"
              min="1"
              max="52"
              value={week === 'all' ? 1 : week}
              class="w-full h-2 rounded-full bg-surface dark:bg-canvas-dark accent-brand-green cursor-pointer"
              oninput="document.getElementById('week-label').textContent = this.value;"
              onchange="const p=new URLSearchParams(window.location.search); p.set('week', this.value); p.set('page','1'); window.location.href='/library?'+p.toString();"
            />
            <a href={buildUrl({ week: 'all', page: 1 })} class="text-xs text-stone hover:underline">Clear week</a>
          </div>

          <!-- Filter: File Format -->
          <div class="space-y-2 pt-2 border-t border-hairline-soft dark:border-hairline-dark">
            <label class="text-xs font-semibold text-ink dark:text-on-dark uppercase tracking-wider block">File Format</label>
            <div class="grid grid-cols-2 gap-2">
              <a
                href={buildUrl({ format: 'all', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'all'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                All
              </a>
              <a
                href={buildUrl({ format: 'pdf', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'pdf'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                PDF
              </a>
              <a
                href={buildUrl({ format: 'docx', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'docx'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                DOCX
              </a>
              <a
                href={buildUrl({ format: 'svg', page: 1 })}
                class={`px-2.5 py-1 text-xs rounded text-center transition-colors ${
                  format === 'svg'
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'bg-surface dark:bg-canvas-dark text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark hover:bg-hairline-soft dark:hover:bg-surface'
                }`}
              >
                SVG/Image
              </a>
            </div>
          </div>

        </div>
      </aside>

      <!-- Main Results Area -->
      <section class="lg:col-span-3">
        <!-- Results Summary Bar -->
        <div class="flex items-center justify-between mb-4 text-xs text-steel dark:text-on-dark-muted">
          <span>
            Showing <strong class="text-ink dark:text-on-dark">{searchResult.items.length}</strong> of <strong class="text-ink dark:text-on-dark">{searchResult.total}</strong> published resources
          </span>
          <span class="text-[11px] text-stone dark:text-on-dark-muted">Page {searchResult.page} of {Math.max(1, searchResult.totalPages)}</span>
        </div>

        <!-- Resource Cards Grid -->
        {searchResult.items.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {searchResult.items.map((res) => (
              <ResourceCard resource={res} />
            ))}
          </div>
        ) : (
          <div class="rounded-xl border border-dashed border-hairline dark:border-hairline-dark p-12 text-center bg-surface-soft dark:bg-surface-code/50">
            <div class="w-12 h-12 rounded-full bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark flex items-center justify-center mx-auto mb-4 text-stone dark:text-on-dark-muted">
              <FileQuestion class="w-6 h-6" />
            </div>
            <h3 class="text-base font-semibold text-ink dark:text-on-dark mb-1">No matching resources found</h3>
            <p class="text-xs text-steel dark:text-on-dark-muted max-w-sm mx-auto mb-6">
              Try adjusting your search terms, removing active filters, or selecting "All Trades".
            </p>
            <a
              href="/library"
              class="inline-flex items-center gap-2 px-5 py-2 bg-primary dark:bg-brand-green text-on-primary dark:text-primary text-xs font-semibold rounded-full hover:bg-charcoal dark:hover:bg-brand-green-deep transition-colors"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Reset all filters</span>
            </a>
          </div>
        )}

        <!-- Pagination Controls -->
        {searchResult.totalPages > 1 && (
          <div class="mt-10 pt-6 border-t border-hairline-soft dark:border-hairline-dark flex items-center justify-between">
            <div>
              {searchResult.page > 1 ? (
                <a
                  href={buildUrl({ page: searchResult.page - 1 })}
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-canvas dark:bg-surface-code border border-hairline dark:border-hairline-dark hover:bg-surface dark:hover:bg-canvas-dark rounded-lg text-xs font-medium text-ink dark:text-on-dark transition-colors"
                >
                  <ChevronLeft class="w-4 h-4" />
                  <span>Previous</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-surface dark:bg-surface-code/40 border border-hairline dark:border-hairline-dark rounded-lg text-xs font-medium text-muted dark:text-on-dark-muted/40 cursor-not-allowed">
                  <ChevronLeft class="w-4 h-4" />
                  <span>Previous</span>
                </span>
              )}
            </div>

            <!-- Page Number Indicators -->
            <div class="flex items-center gap-1 text-xs">
              {Array.from({ length: searchResult.totalPages }, (_, i) => i + 1).map((p) => (
                <a
                  href={buildUrl({ page: p })}
                  class={`w-8 h-8 flex items-center justify-center rounded-lg transition-colors ${
                    p === searchResult.page
                      ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                      : 'bg-canvas dark:bg-surface-code border border-hairline dark:border-hairline-dark text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark'
                  }`}
                >
                  {p}
                </a>
              ))}
            </div>

            <div>
              {searchResult.hasMore ? (
                <a
                  href={buildUrl({ page: searchResult.page + 1 })}
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-canvas dark:bg-surface-code border border-hairline dark:border-hairline-dark hover:bg-surface dark:hover:bg-canvas-dark rounded-lg text-xs font-medium text-ink dark:text-on-dark transition-colors"
                >
                  <span>Next</span>
                  <ChevronRight class="w-4 h-4" />
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-surface dark:bg-surface-code/40 border border-hairline dark:border-hairline-dark rounded-lg text-xs font-medium text-muted dark:text-on-dark-muted/40 cursor-not-allowed">
                  <span>Next</span>
                  <ChevronRight class="w-4 h-4" />
                </span>
              )}
            </div>
          </div>
        )}

      </section>

    </div>

  </div>
</Layout>
