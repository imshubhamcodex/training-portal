---
import { Search } from 'lucide-astro';
import { getAllResources } from '../../lib/data/resources';

export interface Props {
  id?: string;
  placeholder?: string;
  defaultValue?: string;
  action?: string;
  size?: 'default' | 'large';
  preserveParams?: Record<string, string>;
}

const {
  id = 'search-box',
  placeholder = 'Search lesson plans, lab manuals, subjects, or topics...',
  defaultValue = '',
  action = '/library',
  size = 'default',
  preserveParams = {},
} = Astro.props;

// Build suggestion data for client-side search
const published = getAllResources();
const suggestionData = published.map((r) => ({
  title: r.title,
  slug: r.slug,
  type: r.resource_type,
  trade: r.trade_name,
  subject: r.subject_name,
  tags: r.tags,
}));

const suggestionJSON = JSON.stringify(suggestionData);
const inputId = `${id}-input`;
const dropdownId = `${id}-dropdown`;
const resultsId = `${id}-results`;
const noResultsId = `${id}-no-results`;

const inputClass =
  size === 'large'
    ? 'w-full pl-12 pr-32 py-3.5 sm:py-4 bg-white rounded-full border border-[#e5e5e5] focus:outline-none focus:ring-2 focus:ring-[#00d4a4] focus:border-transparent text-sm sm:text-base text-[#0a0a0a] shadow-sm transition-all'
    : 'w-full pl-12 pr-28 py-3.5 bg-white rounded-full border border-[#e5e5e5] focus:outline-none focus:ring-2 focus:ring-[#00d4a4] focus:border-transparent text-sm text-[#0a0a0a] shadow-sm';

const buttonClass =
  size === 'large'
    ? 'absolute right-1.5 sm:right-2 top-1.5 bottom-1.5 px-4 sm:px-6 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs sm:text-sm font-medium transition-colors'
    : 'absolute right-2 top-2 bottom-2 px-5 bg-[#0a0a0a] hover:bg-[#1c1c1e] text-white rounded-full text-xs font-medium transition-colors';
---

<div class="relative w-full" id={id}>
  <form action={action} method="GET" class="relative flex items-center" autocomplete="off">
    <!-- Hidden fields to preserve other query parameters -->
    {Object.entries(preserveParams).map(([key, val]) => val && val !== 'all' && (
      <input type="hidden" name={key} value={val} />
    ))}

    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[#888888]">
      <Search class="w-5 h-5" />
    </div>

    <input
      id={inputId}
      type="text"
      name="q"
      value={defaultValue}
      placeholder={placeholder}
      class={inputClass}
      aria-label="Search resources"
      aria-autocomplete="list"
      aria-controls={dropdownId}
      aria-expanded="false"
      role="combobox"
    />

    <button type="submit" class={buttonClass}>
      <span>Search</span>
    </button>
  </form>

  <!-- Autocomplete Dropdown -->
  <div
    id={dropdownId}
    role="listbox"
    aria-label="Search suggestions"
    class="absolute top-full left-0 right-0 mt-1.5 bg-white border border-[#e5e5e5] rounded-xl shadow-xl overflow-hidden z-50 hidden"
    style="max-height: 400px; overflow-y: auto;"
  >
    <div id={resultsId} class="text-left"></div>
    <div id={noResultsId} class="hidden px-4 py-3 text-xs text-[#888888] text-center">
      No matching resources found. Press Enter to search all.
    </div>
  </div>
</div>

<script define:vars={{ suggestionJSON, inputId, dropdownId, resultsId, noResultsId, action }}>
  const suggestions = JSON.parse(suggestionJSON);
  const input = document.getElementById(inputId);
  const dropdown = document.getElementById(dropdownId);
  const resultsContainer = document.getElementById(resultsId);
  const noResults = document.getElementById(noResultsId);

  if (input && dropdown && resultsContainer && noResults) {
    const typeLabels = {
      'lesson-plan': 'Lesson Plan',
      'demonstration-plan': 'Demo Plan',
      'lab-manual': 'Lab Manual',
      'notes': 'Notes',
      'diagram': 'Diagram',
      'video': 'Video',
      'question-bank': 'Question Bank',
      'reference': 'Reference',
    };

    const typeBadgeClass = {
      'lesson-plan': 'bg-emerald-50 text-emerald-700 border-emerald-200',
      'demonstration-plan': 'bg-blue-50 text-blue-700 border-blue-200',
      'lab-manual': 'bg-purple-50 text-purple-700 border-purple-200',
      'notes': 'bg-amber-50 text-amber-700 border-amber-200',
      'diagram': 'bg-rose-50 text-rose-700 border-rose-200',
      'video': 'bg-indigo-50 text-indigo-700 border-indigo-200',
      'question-bank': 'bg-teal-50 text-teal-700 border-teal-200',
      'reference': 'bg-slate-100 text-slate-700 border-slate-200',
    };

    let activeIndex = -1;

    function getMatches(query) {
      if (!query || query.trim().length < 2) return [];
      const q = query.toLowerCase().trim();
      const tokens = q.split(/\s+/).filter(Boolean);
      return suggestions
        .filter((s) => {
          const blob = `${s.title} ${s.subject} ${s.trade} ${s.tags.join(' ')}`.toLowerCase();
          return tokens.every((t) => blob.includes(t));
        })
        .slice(0, 7);
    }

    function highlightMatch(text, query) {
      if (!query || query.length < 2) return text;
      try {
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp('(' + escaped + ')', 'gi'), '<mark class="bg-[#00d4a4]/20 rounded px-0.5 not-italic">$1</mark>');
      } catch {
        return text;
      }
    }

    function renderSuggestions(matches, query) {
      if (matches.length === 0) {
        resultsContainer.innerHTML = '';
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
        resultsContainer.innerHTML = matches
          .map((m, i) => {
            const badgeClass = typeBadgeClass[m.type] || 'bg-gray-100 text-gray-700 border-gray-200';
            const label = typeLabels[m.type] || m.type;
            const highlightedTitle = highlightMatch(m.title, query);
            return (
              '<a href="/resources/' + m.slug + '" class="flex items-start gap-3 px-4 py-3 hover:bg-[#fafafa] transition-colors cursor-pointer border-b border-[#f0f0f0] last:border-b-0 suggestion-item" data-index="' + i + '" role="option" aria-selected="false">' +
                '<div class="flex-1 min-w-0">' +
                  '<p class="text-sm font-medium text-[#0a0a0a] leading-snug truncate">' + highlightedTitle + '</p>' +
                  '<p class="text-[11px] text-[#888888] mt-0.5 truncate">' + m.trade + ' &middot; ' + m.subject + '</p>' +
                '</div>' +
                '<span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border mt-0.5 ' + badgeClass + '">' + label + '</span>' +
              '</a>'
            );
          })
          .join('');

        resultsContainer.innerHTML +=
          '<button type="button" class="w-full flex items-center gap-2 px-4 py-2.5 text-xs font-medium text-[#5a5a5c] hover:bg-[#fafafa] border-t border-[#ededed] transition-colors search-all-btn">' +
            '<svg class="w-3.5 h-3.5 text-[#888888]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>' +
            'Search all results for &ldquo;<span class="font-semibold text-[#0a0a0a]">' + query + '</span>&rdquo;' +
          '</button>';

        const searchAllBtn = resultsContainer.querySelector('.search-all-btn');
        if (searchAllBtn) {
          searchAllBtn.addEventListener('click', () => {
            window.location.href = action + '?q=' + encodeURIComponent(input.value.trim());
          });
        }
      }
    }

    function openDropdown() {
      dropdown.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    }

    function updateActive(items) {
      items.forEach((item, i) => {
        if (i === activeIndex) {
          item.classList.add('bg-[#f0fdfb]');
          item.setAttribute('aria-selected', 'true');
        } else {
          item.classList.remove('bg-[#f0fdfb]');
          item.setAttribute('aria-selected', 'false');
        }
      });
    }

    let debounceTimer;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = input.value.trim();
        if (query.length < 2) {
          closeDropdown();
          return;
        }
        const matches = getMatches(query);
        renderSuggestions(matches, query);
        openDropdown();
        activeIndex = -1;
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = Array.from(resultsContainer.querySelectorAll('.suggestion-item'));
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        updateActive(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, -1);
        updateActive(items);
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        items[activeIndex].click();
      } else if (e.key === 'Escape') {
        closeDropdown();
      }
    });

    document.addEventListener('click', (e) => {
      const container = document.getElementById(input.id.replace('-input', ''));
      if (!container || !container.contains(e.target)) {
        closeDropdown();
      }
    });

    input.addEventListener('focus', () => {
      const query = input.value.trim();
      if (query.length >= 2) {
        const matches = getMatches(query);
        if (matches.length > 0) {
          renderSuggestions(matches, query);
          openDropdown();
        }
      }
    });
  }
</script>
