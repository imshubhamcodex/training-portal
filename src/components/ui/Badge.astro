---
export interface Props {
  variant?: 'mint' | 'tag-blue' | 'warn' | 'error' | 'surface' | 'neutral' | 'outline';
  class?: string;
  size?: 'sm' | 'md';
}

const { variant = 'neutral', class: className = '', size = 'md' } = Astro.props;

const variantStyles: Record<string, string> = {
  mint: 'bg-brand-green text-primary font-semibold',
  'tag-blue': 'bg-[rgba(55,114,207,0.12)] dark:bg-[rgba(55,114,207,0.25)] text-brand-tag font-semibold border border-[rgba(55,114,207,0.2)]',
  warn: 'bg-[rgba(195,125,13,0.12)] dark:bg-[rgba(195,125,13,0.25)] text-brand-warn font-semibold border border-[rgba(195,125,13,0.2)]',
  error: 'bg-brand-error text-on-dark font-semibold',
  surface: 'bg-surface dark:bg-surface-code text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark font-mono',
  neutral: 'bg-surface dark:bg-surface-code text-charcoal dark:text-on-dark border border-hairline dark:border-hairline-dark',
  outline: 'bg-transparent text-steel dark:text-on-dark-muted border border-hairline dark:border-hairline-dark',
};

const sizeStyles = {
  sm: 'text-[11px] px-2 py-0.5 rounded',
  md: 'text-[12px] px-2.5 py-1 rounded-full',
};
---

<span class={`inline-flex items-center gap-1.5 transition-colors ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  <slot />
</span>