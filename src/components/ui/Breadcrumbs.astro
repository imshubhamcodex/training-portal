---
import { ChevronRight, Home } from 'lucide-astro';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 text-xs md:text-sm text-[#5a5a5c]">
  <ol class="flex items-center flex-wrap gap-1.5">
    <li class="inline-flex items-center">
      <a href="/" class="hover:text-[#0a0a0a] transition-colors inline-flex items-center gap-1">
        <Home class="w-3.5 h-3.5" />
        <span class="sr-only md:not-sr-only">Home</span>
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5">
          <ChevronRight class="w-3.5 h-3.5 text-[#a8a8aa]" />
          {item.href && !isLast ? (
            <a href={item.href} class="hover:text-[#0a0a0a] transition-colors">
              {item.label}
            </a>
          ) : (
            <span class="text-[#0a0a0a] font-medium" aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
