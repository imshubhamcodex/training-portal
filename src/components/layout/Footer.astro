---
import { BookOpen, ExternalLink, Heart, Shield, FileCheck } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0a0a0a] border-t border-[#1f2937] text-[#94a3b8] text-sm mt-auto" role="contentinfo">
  <!-- Main Footer Columns -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">
      
      <!-- Column 1: Brand & Identity -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-[#0a0a0a] flex items-center justify-center text-white">
            <BookOpen class="w-4 h-4 text-[#00d4a4]" />
          </div>
          <span class="font-bold text-lg text-white tracking-tight">ITI Resource Hub</span>
        </a>
        <p class="text-sm text-[#94a3b8] max-w-sm leading-relaxed">
          A dedicated, open vocational educational portal providing standardized lesson plans, practical demonstration procedures, laboratory manuals, and engineering diagrams for ITI instructors and trainees across India.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-[#1f2937] border border-[#374151] rounded-full text-[#e2e8f0]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00d4a4]"></span>
            Craftsmen Training Scheme (CTS)
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-[#1f2937] border border-[#374151] rounded-full text-[#e2e8f0]">
            NIMI Framework
          </span>
        </div>
      </div>

      <!-- Column 2: Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-[#e2e8f0] uppercase tracking-wider">Resources</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/categories/lesson-plans" class="text-[#cbd5e1] hover:text-white transition-colors">Lesson Plans</a></li>
          <li><a href="/categories/demonstration-plans" class="text-[#cbd5e1] hover:text-white transition-colors">Demonstration Plans</a></li>
          <li><a href="/categories/lab-manuals" class="text-[#cbd5e1] hover:text-white transition-colors">Lab Manuals & Practical</a></li>
          <li><a href="/categories/notes" class="text-[#cbd5e1] hover:text-white transition-colors">Subject Notes & Guides</a></li>
          <li><a href="/categories/videos-images" class="text-[#cbd5e1] hover:text-white transition-colors">Diagrams & Media</a></li>
          <li><a href="/library" class="text-[#cbd5e1] font-medium hover:text-white">Complete Catalog</a></li>
        </ul>
      </div>

      <!-- Column 3: Trades -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-[#e2e8f0] uppercase tracking-wider">Trades</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/trades/ictsm" class="inline-flex items-center gap-1 hover:text-white transition-colors font-medium text-[#cbd5e1]">
              ICTSM
            </a>
          </li>
          <li><a href="/trades/electrician" class="text-[#cbd5e1] hover:text-white transition-colors">Electrician</a></li>
          <li><a href="/trades/fitter" class="text-[#cbd5e1] hover:text-white transition-colors">Fitter</a></li>
          <li><a href="/trades/copa" class="text-[#cbd5e1] hover:text-white transition-colors">COPA</a></li>
          <li><a href="/trades" class="text-[#cbd5e1] hover:text-white transition-colors">All Trades Directory</a></li>
        </ul>
      </div>

      <!-- Column 4: Institutional & Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-[#e2e8f0] uppercase tracking-wider">Portal & Policy</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/notices" class="text-[#cbd5e1] hover:text-white transition-colors">Important Notices</a></li>
          <li><a href="/about" class="text-[#cbd5e1] hover:text-white transition-colors">About the Portal</a></li>
          <li><a href="/contact" class="text-[#cbd5e1] hover:text-white transition-colors">Content Correction Request</a></li>
          <li><a href="/copyright" class="text-[#cbd5e1] hover:text-white transition-colors">Copyright & Attribution</a></li>
          <li><a href="/privacy" class="text-[#cbd5e1] hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/admin" class="text-[#cbd5e1] hover:text-white transition-colors">Administrator Access</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal / Attribution Row -->
    <div class="mt-12 pt-8 border-t border-[#1f2937] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#94a3b8]">
      <p>
        © {currentYear} ITI Resource Hub. Instructional aids designed for vocational education under CTS/NCVT frameworks.
      </p>
      <div class="flex items-center gap-4">
        <span>Attribution: NIMI / DGT Reference Models</span>
        <span class="hidden sm:inline">•</span>
        <a href="/contact" class="hover:text-white underline">Report Discrepancy</a>
      </div>
    </div>
  </div>
</footer>
