---
import { Search, Menu, X, BookOpen, Layers, Bell, Info, ShieldAlert, Cpu, Moon, Sun } from 'lucide-astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Resource Library', href: '/library' },
  { label: 'Trades', href: '/trades' },
  { label: 'Notices', href: '/notices' },
  { label: 'About', href: '/about' },
];

function isActive(href: string): boolean {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
}
---

<header class="sticky top-0 z-[9999] bg-canvas/95 backdrop-blur-md border-b border-hairline dark:bg-canvas-dark/95 dark:border-hairline-dark transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-green rounded-lg p-1">
        <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center text-on-primary shadow-sm group-hover:scale-105 transition-transform">
          <BookOpen class="w-5 h-5 text-brand-green" />
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-[17px] tracking-tight text-ink dark:text-on-dark">ITI Resource Hub</span>
          <span class="text-[11px] text-steel dark:text-on-dark-muted font-normal leading-none hidden sm:block">Vocational Training Library</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main Navigation">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-sm font-medium rounded-md transition-colors ${
                active
                  ? 'text-ink bg-surface dark:text-on-dark dark:bg-surface-code'
                  : 'text-steel dark:text-on-dark-muted hover:text-ink dark:hover:text-on-dark hover:bg-surface dark:hover:bg-surface-code'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle theme-toggle-btn"
          aria-label="Toggle theme"
          title="Toggle theme"
        >
          <Sun class="icon-sun w-4 h-4 text-amber-400" />
          <Moon class="icon-moon w-4 h-4 text-steel dark:text-on-dark-muted" />
        </button>

        <!-- Admin Portal Access -->
        <a
          href="/admin"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-charcoal dark:text-on-dark bg-canvas dark:bg-canvas-dark border border-hairline dark:border-hairline-dark hover:border-primary dark:hover:border-brand-green rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-brand-green"
        >
          <ShieldAlert class="w-3.5 h-3.5 text-steel dark:text-on-dark-muted" />
          <span>Admin</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2 rounded-md text-steel dark:text-on-dark-muted hover:text-ink dark:hover:text-on-dark hover:bg-surface dark:hover:bg-surface-code focus:outline-none focus:ring-2 focus:ring-brand-green"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle Navigation Menu"
        >
          <Menu class="w-5 h-5 menu-open-icon" />
          <X class="w-5 h-5 menu-close-icon hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-hairline dark:border-hairline-dark bg-canvas dark:bg-canvas-dark px-4 pt-3 pb-6 shadow-xl animate-in slide-in-from-top-2 duration-200">
    <div class="flex flex-col space-y-1">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-2.5 rounded-md text-base font-medium transition-colors ${
              active
                ? 'bg-surface dark:bg-surface-code text-ink dark:text-on-dark font-semibold'
                : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-surface-code hover:text-ink dark:hover:text-on-dark'
            }`}
          >
            {item.label}
          </a>
        );
      })}
      
      <div class="pt-4 mt-2 border-t border-hairline-soft dark:border-hairline-dark flex items-center justify-between px-1">
        <span class="text-xs font-medium text-steel dark:text-on-dark-muted">Appearance</span>
        <button
          type="button"
          class="theme-toggle-btn inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-hairline dark:border-hairline-dark bg-surface dark:bg-surface-code text-xs font-medium text-charcoal dark:text-on-dark hover:border-steel transition-colors"
          aria-label="Toggle theme"
        >
          <Sun class="icon-sun w-3.5 h-3.5 text-amber-400" />
          <Moon class="icon-moon w-3.5 h-3.5 text-steel" />
          <span class="theme-label-text">Toggle Theme</span>
        </button>
      </div>

      <div class="pt-2 flex flex-col gap-2">
        <a
          href="/admin"
          class="flex items-center justify-center gap-2 w-full py-2 bg-surface dark:bg-surface-code text-charcoal dark:text-on-dark border border-hairline dark:border-hairline-dark rounded-full text-sm font-medium hover:bg-hairline-soft dark:hover:bg-hairline-dark transition-colors"
        >
          <ShieldAlert class="w-4 h-4 text-steel dark:text-on-dark-muted" />
          <span>Instructor / Admin Sign In</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = toggleBtn?.querySelector('.menu-open-icon');
  const closeIcon = toggleBtn?.querySelector('.menu-close-icon');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Comprehensive theme management
  function setupThemeToggles() {
    const themeToggles = document.querySelectorAll('.theme-toggle-btn');
    const labelTexts = document.querySelectorAll('.theme-label-text');

    function syncAria() {
      const isDark = document.documentElement.classList.contains('dark');
      themeToggles.forEach((btn) => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        btn.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      });
      labelTexts.forEach((el) => {
        el.textContent = isDark ? 'Light Mode' : 'Dark Mode';
      });
    }

    function toggleTheme(e) {
      const btn = e && e.currentTarget ? e.currentTarget : document.querySelector('.theme-toggle-btn');
      const rect = btn ? btn.getBoundingClientRect() : { left: window.innerWidth/2, top: window.innerHeight/2, width: 0, height: 0 };
      const x = rect.left + rect.width/2;
      const y = rect.top + rect.height/2;
      const maxR = Math.hypot(Math.max(x, window.innerWidth-x), Math.max(y, window.innerHeight-y));
      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;z-index:99999;pointer-events:none;background:' + (document.documentElement.classList.contains('dark') ? '#f8fafc' : '#0f172a') + ';clip-path:circle(0px at '+x+'px '+y+'px);transition:clip-path .7s ease-in-out;';
      document.body.appendChild(overlay);
      requestAnimationFrame(() => { overlay.style.clipPath = 'circle('+maxR+'px at '+x+'px '+y+'px)'; });
      setTimeout(() => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) {}
        syncAria();
        setTimeout(() => overlay.remove(), 100);
      }, 700);
    }

    themeToggles.forEach((btn) => {
      btn.addEventListener('click', toggleTheme);
    });

    syncAria();

    // Cross-tab theme sync
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') {
        if (e.newValue === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        syncAria();
      }
    });

    // MatchMedia OS theme change listener
    try {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      mediaQuery.addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          syncAria();
        }
      });
    } catch (_) {}
  }

  setupThemeToggles();

  // Global keyboard shortcut for search (Command/Ctrl + K)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = '/library';
    }
  });
</script>