---
import type { Notice } from '../../types';
import Badge from '../ui/Badge.astro';
import { isNoticeExpired } from '../../lib/data/notices';
import { Bell, Calendar, Download, Building2 } from 'lucide-astro';

export interface Props {
  notice: Notice;
  compact?: boolean;
}

const { notice, compact = false } = Astro.props;

const expired = isNoticeExpired(notice);

const categoryBadgeMap: Record<string, { label: string; variant: 'mint' | 'tag-blue' | 'warn' | 'error' | 'surface' | 'neutral' }> = {
  curriculum: { label: 'Curriculum', variant: 'mint' },
  exam: { label: 'Examination', variant: 'tag-blue' },
  circular: { label: 'Circular', variant: 'surface' },
  admission: { label: 'Admission', variant: 'warn' },
  general: { label: 'General', variant: 'neutral' },
};

const badgeInfo = categoryBadgeMap[notice.category] || { label: notice.category, variant: 'neutral' };

const pubDate = new Date(notice.published_at).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class={`rounded-xl border ${notice.is_pinned ? 'border-brand-green bg-brand-green-soft/20 dark:bg-brand-green/10' : 'border-hairline dark:border-hairline-dark bg-canvas dark:bg-canvas-dark'} p-5 transition-all hover:border-steel dark:hover:border-steel`}>
  <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
    <div class="flex items-center gap-2">
      <Badge variant={badgeInfo.variant} size="sm">
        {badgeInfo.label}
      </Badge>

      {expired ? (
        <span class="px-2 py-0.5 text-[10px] font-medium bg-surface dark:bg-surface-code text-muted dark:text-on-dark-muted rounded border border-hairline dark:border-hairline-dark">
          Expired / Archive
        </span>
      ) : (
        <span class="px-2 py-0.5 text-[10px] font-medium bg-brand-green-soft/60 dark:bg-brand-green/15 text-brand-green-deep dark:text-brand-green rounded border border-brand-green/20 dark:border-brand-green/30">
          Active
        </span>
      )}
    </div>

    <div class="flex items-center gap-1 text-xs text-muted dark:text-on-dark-muted">
      <Calendar class="w-3 h-3" />
      <span>{pubDate}</span>
    </div>
  </div>

  <h3 class="text-base font-semibold text-ink dark:text-on-dark hover:text-brand-green-deep transition-colors leading-snug mb-2">
    <a href={`/notices/${notice.slug}`} class="focus:outline-none focus:underline">
      {notice.title}
    </a>
  </h3>

  {notice.source_name && (
    <p class="text-xs text-steel dark:text-on-dark-muted flex items-center gap-1.5 mb-2">
      <Building2 class="w-3.5 h-3.5 text-muted dark:text-on-dark-muted" />
      <span>Issuing Authority: <strong class="text-charcoal dark:text-on-dark">{notice.source_name}</strong></span>
    </p>
  )}

  {!compact && (
    <p class="text-xs text-steel dark:text-on-dark-muted line-clamp-3 leading-relaxed mb-4 min-h-[72px]">
      {notice.body}
    </p>
  )}

  <div class="pt-3 border-t border-hairline-soft dark:border-hairline-dark flex items-center justify-between gap-2 text-xs">
    <a href={`/notices/${notice.slug}`} class="text-ink dark:text-on-dark font-medium hover:text-brand-green-deep transition-colors">
      Read full circular →
    </a>

    {notice.attachment_url && (
      <a
        href={notice.attachment_url}
        download={notice.attachment_name || 'Notice_Attachment.pdf'}
        class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-charcoal dark:text-on-dark bg-surface dark:bg-surface-code hover:bg-hairline-soft dark:hover:bg-hairline-dark rounded-full transition-colors"
      >
        <Download class="w-3 h-3 text-brand-green-deep" />
        <span>Attachment</span>
      </a>
    )}
  </div>
</article>
