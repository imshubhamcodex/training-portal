---
import '../../styles/global.css';
import {
  LayoutDashboard,
  FileText,
  PlusCircle,
  Cpu,
  Layers,
  Bell,
  Settings,
  LogOut,
  ExternalLink,
  ShieldCheck,
  Menu,
  X,
  Sun,
  Moon,
} from 'lucide-astro';

export interface Props {
  title: string;
  activeNav: 'dashboard' | 'resources' | 'new-resource' | 'trades' | 'subjects' | 'notices' | 'settings';
}

const { title, activeNav } = Astro.props;

const navItems = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin', icon: LayoutDashboard },
  { key: 'resources', label: 'All Resources', href: '/admin/resources', icon: FileText },
  { key: 'new-resource', label: 'Add Resource', href: '/admin/resources/new', icon: PlusCircle },
  { key: 'trades', label: 'Trades', href: '/admin/trades', icon: Cpu },
  { key: 'subjects', label: 'Subjects', href: '/admin/subjects', icon: Layers },
  { key: 'notices', label: 'Notices', href: '/admin/notices', icon: Bell },
  { key: 'settings', label: 'Settings', href: '/admin/settings', icon: Settings },
];
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Admin Portal - ITI Resource Hub</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Synchronous to prevent FOUC) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-surface dark:bg-canvas-dark text-ink dark:text-on-dark antialiased transition-colors duration-200">
    
    <!-- Top Administrative Header -->
    <header class="bg-primary dark:bg-canvas-dark text-on-primary border-b border-hairline-dark sticky top-0 z-40 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/admin" class="flex items-center gap-2 text-white font-bold text-sm tracking-tight">
            <span class="w-6 h-6 rounded bg-[#00d4a4] text-[#0a0a0a] flex items-center justify-center text-xs font-black">
              ITI
            </span>
            <span>Resource Hub Admin</span>
          </a>
          <span class="px-2 py-0.5 text-[10px] bg-charcoal dark:bg-surface-code text-brand-green rounded font-mono border border-hairline-dark">
            Secured Console
          </span>
        </div>

        <div class="flex items-center gap-3 sm:gap-4 text-xs">
          <!-- Theme Toggle -->
          <button
            id="admin-theme-toggle"
            type="button"
            class="theme-toggle theme-toggle-btn !w-8 !h-8 border-hairline-dark bg-charcoal dark:bg-surface-code text-on-dark-muted hover:text-white hover:border-steel"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            <Sun class="icon-sun w-4 h-4 text-amber-400" />
            <Moon class="icon-moon w-4 h-4 text-steel dark:text-on-dark-muted" />
          </button>

          <a
            href="/"
            target="_blank"
            class="text-[#b3b3b3] hover:text-white transition-colors hidden sm:inline-flex items-center gap-1"
          >
            <span>View Public Site</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>

          <button
            id="admin-signout-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1c1c1e] hover:bg-[#2d2d30] text-white rounded-full transition-colors border border-[#333]"
          >
            <LogOut class="w-3.5 h-3.5 text-[#00d4a4]" />
            <span>Sign Out</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Admin Main Body with Left Sidebar -->
    <div class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 md:grid-cols-5 gap-6">
      
      <!-- Left Admin Navigation -->
      <aside class="md:col-span-1">
        <nav class="bg-canvas dark:bg-surface-code rounded-xl border border-hairline dark:border-hairline-dark p-3 space-y-1 sticky top-20 shadow-xs transition-colors">
          <div class="px-3 py-2 text-[10px] font-semibold text-stone dark:text-on-dark-muted uppercase tracking-wider">
            Management Console
          </div>
          {navItems.map((item) => {
            const IconComp = item.icon;
            const isActive = activeNav === item.key;
            return (
              <a
                href={item.href}
                class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition-colors ${
                  isActive
                    ? 'bg-primary dark:bg-brand-green text-on-primary dark:text-primary font-semibold shadow-xs'
                    : 'text-steel dark:text-on-dark-muted hover:bg-surface dark:hover:bg-canvas-dark hover:text-ink dark:hover:text-on-dark'
                }`}
              >
                <IconComp class={`w-4 h-4 ${isActive ? 'text-brand-green dark:text-primary' : 'text-stone dark:text-on-dark-muted'}`} />
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      <!-- Main Content Area -->
      <main class="md:col-span-4 space-y-6">
        <slot />
      </main>

    </div>

    <!-- Client-side session and auth guard script -->
    <script>
      // Verify admin session in browser
      const isAuthenticated = localStorage.getItem('iti_admin_authenticated') === 'true';
      const isLoginPage = window.location.pathname.includes('/admin/login');

      if (!isAuthenticated && !isLoginPage) {
        // Redirect to login if unauthenticated
        window.location.href = '/admin/login';
      }

      // Sign out handler
      const signOutBtn = document.getElementById('admin-signout-btn');
      signOutBtn?.addEventListener('click', () => {
        localStorage.removeItem('iti_admin_authenticated');
        localStorage.removeItem('iti_admin_email');
        window.location.href = '/admin/login';
      });

      // Admin Theme toggle handler
      const themeToggle = document.getElementById('admin-theme-toggle');
      function syncAdminThemeAria() {
        const isDark = document.documentElement.classList.contains('dark');
        if (themeToggle) {
          themeToggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          themeToggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
          themeToggle.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        }
      }

      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
        syncAdminThemeAria();
      });

      syncAdminThemeAria();
    </script>
  </body>
</html>
