---
import type { Resource } from '../../types';
import { Download, Eye, Clock, Layers, Cpu, Zap, Wrench, Terminal } from 'lucide-astro';

export interface Props {
  resource: Resource;
  compact?: boolean;
}

const { resource, compact = false } = Astro.props;

// Specific vibrant colors for different resource types
const typeBadgeConfig: Record<string, { label: string; badgeClass: string }> = {
  'lesson-plan': {
    label: 'Lesson Plan',
    badgeClass: 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border-emerald-200/80 dark:border-emerald-800/60',
  },
  'demonstration-plan': {
    label: 'Demonstration Plan',
    badgeClass: 'bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border-blue-200/80 dark:border-blue-800/60',
  },
  'lab-manual': {
    label: 'Lab Manual',
    badgeClass: 'bg-purple-50 dark:bg-purple-950/40 text-purple-800 dark:text-purple-300 border-purple-200/80 dark:border-purple-800/60',
  },
  'notes': {
    label: 'Subject Notes',
    badgeClass: 'bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/60',
  },
  'diagram': {
    label: 'Technical Diagram',
    badgeClass: 'bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border-rose-200/80 dark:border-rose-800/60',
  },
  'video': {
    label: 'Demonstration Video',
    badgeClass: 'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-800 dark:text-indigo-300 border-indigo-200/80 dark:border-indigo-800/60',
  },
  'question-bank': {
    label: 'Question Bank',
    badgeClass: 'bg-teal-50 dark:bg-teal-950/40 text-teal-800 dark:text-teal-300 border-teal-200/80 dark:border-teal-800/60',
  },
  'reference': {
    label: 'Reference Guide',
    badgeClass: 'bg-slate-100 dark:bg-slate-800/60 text-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700',
  },
};

const badgeInfo = typeBadgeConfig[resource.resource_type] || {
  label: resource.resource_type,
  badgeClass: 'bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-300 border-gray-300 dark:border-gray-700',
};

// Distinct color + icon per trade for the trade pill
const tradeBadgeConfig: Record<string, { label: string; badgeClass: string; icon: any }> = {
  ictsm: {
    label: 'ICTSM',
    badgeClass: 'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-800 dark:text-indigo-300 border-indigo-200/80 dark:border-indigo-800/60',
    icon: Cpu,
  },
  electrician: {
    label: 'Electrician',
    badgeClass: 'bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/60',
    icon: Zap,
  },
  fitter: {
    label: 'Fitter',
    badgeClass: 'bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border-rose-200/80 dark:border-rose-800/60',
    icon: Wrench,
  },
  copa: {
    label: 'COPA',
    badgeClass: 'bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border-blue-200/80 dark:border-blue-800/60',
    icon: Terminal,
  },
};

const tradeBadge = tradeBadgeConfig[resource.trade_slug] || {
  label: resource.trade_name,
  badgeClass: 'bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-300 border-gray-300 dark:border-gray-700',
  icon: Layers,
};
const TradeIcon = tradeBadge.icon;

const primaryFile = resource.files.find((f) => f.is_primary) || resource.files[0];
const fileExt = primaryFile ? primaryFile.original_filename.split('.').pop()?.toUpperCase() : 'PDF';

// Training year formatted as 1st Year or 2nd Year
const yearText = resource.training_year === 1 ? '1st Year' : `${resource.training_year}nd Year`;
const jobNumberText = resource.job_number || `Job #${resource.sort_order || 1}`;

// "This Week" badge for resources published within the last 7 days
const publishedDate = resource.published_at ? new Date(resource.published_at) : null;
const now = new Date();
const isThisWeek = publishedDate ? now.getTime() - publishedDate.getTime() <= 7 * 24 * 60 * 60 * 1000 : false;

// Distinctive colors for 1st Year vs 2nd Year badges
const yearBadgeClass = resource.training_year === 1
  ? 'bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border-blue-200/70 dark:border-blue-800/60'
  : 'bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 border-purple-200/70 dark:border-purple-800/60';
---

<article class="group relative flex flex-col justify-between bg-canvas dark:bg-canvas-dark rounded-xl border border-hairline dark:border-hairline-dark p-5 hover:border-steel dark:hover:border-steel hover:shadow-md transition-all">
  <div>
    <!-- Top Row: Type Badge, Trade & This Week Pill -->
    <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
      <div class="flex items-center gap-1.5 flex-wrap">
        <!-- Badge with distinct color per resource type -->
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeInfo.badgeClass}`}>
          {badgeInfo.label}
        </span>
        <!-- Trade pill with distinct color and icon per trade -->
        <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold border flex-wrap ${tradeBadge.badgeClass}`}>
          <TradeIcon class="w-3 h-3" />
          {tradeBadge.label}
        </span>
      </div>

      {isThisWeek && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-brand-green-deep dark:text-brand-green bg-brand-green-soft/60 dark:bg-brand-green/15 px-2 py-0.5 rounded-full border border-brand-green/30">
          <Clock class="w-3 h-3" />
          This Week
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-[16px] font-semibold text-ink dark:text-on-dark group-hover:text-brand-green-deep transition-colors leading-snug mb-2 line-clamp-2">
      <a href={`/resources/${resource.slug}`} class="focus:outline-none focus:underline">
        {resource.title}
      </a>
    </h3>

    <!-- Subject Name -->
    <p class="text-xs font-medium text-steel dark:text-on-dark-muted mb-2 flex items-center gap-1">
      <Layers class="w-3.5 h-3.5 text-muted dark:text-on-dark-muted" />
      <span>{resource.subject_name}</span>
    </p>

    <!-- Description Excerpt -->
    {!compact && (
      <p class="text-xs text-steel dark:text-on-dark-muted line-clamp-2 mb-4 leading-relaxed">
        {resource.description}
      </p>
    )}

    <!-- Tags -->
    {resource.tags && resource.tags.length > 0 && !compact && (
      <div class="flex items-center gap-1.5 flex-wrap mb-4">
        {resource.tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] text-steel dark:text-on-dark-muted bg-surface-soft dark:bg-surface-code border border-hairline-soft dark:border-hairline-dark px-1.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Row / Footer: Year, Job Number, Format, and Icon-only Action Buttons -->
  <div class="pt-3 border-t border-hairline-soft dark:border-hairline-dark flex items-center justify-between gap-2 text-xs">
    
    <!-- Left Metadata: Format, 1st/2nd Year, Job Number (File size removed) -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="font-mono px-1.5 py-0.5 bg-surface dark:bg-surface-code border border-hairline dark:border-hairline-dark rounded text-[10px] font-medium text-ink dark:text-on-dark">
        {fileExt}
      </span>
      <span class={`px-2 py-0.5 rounded text-[11px] font-medium border ${yearBadgeClass}`}>
        {yearText}
      </span>
      <span class="px-2 py-0.5 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200/70 dark:border-blue-700/50 rounded text-[11px] font-mono font-medium">
        {jobNumberText}
      </span>
    </div>

    <!-- Right Actions: Icon-only buttons with tooltips / aria-labels (text removed) -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <a
        href={`/resources/${resource.slug}`}
        class="inline-flex items-center justify-center p-2 rounded-full text-charcoal dark:text-on-dark bg-surface dark:bg-surface-code hover:bg-hairline-soft dark:hover:bg-hairline-dark transition-colors focus:outline-none focus:ring-2 focus:ring-brand-green"
        title="Preview Document"
        aria-label="Preview Document"
      >
        <Eye class="w-4 h-4" />
        <span class="sr-only">Preview Document</span>
      </a>

      {primaryFile && (
        <a
          href={primaryFile.download_url}
          download={primaryFile.original_filename}
          class="inline-flex items-center justify-center p-2 rounded-full text-on-primary bg-primary dark:bg-surface-code hover:bg-charcoal dark:hover:bg-surface-soft border border-transparent dark:border-hairline-dark transition-colors focus:outline-none focus:ring-2 focus:ring-brand-green"
          title="Download File"
          aria-label="Download File"
        >
          <Download class="w-4 h-4 text-brand-green" />
          <span class="sr-only">Download File</span>
        </a>
      )}
    </div>

  </div>
</article>
