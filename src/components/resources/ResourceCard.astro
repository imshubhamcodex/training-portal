---
import type { Resource } from '../../types';
import { Download, Eye, Clock, Layers, Cpu, Zap, Wrench, Terminal } from 'lucide-astro';

export interface Props {
  resource: Resource;
  compact?: boolean;
}

const { resource, compact = false } = Astro.props;

// Specific vibrant colors for different resource types
const typeBadgeConfig: Record<string, { label: string; badgeClass: string }> = {
  'lesson-plan': {
    label: 'Lesson Plan',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200/80',
  },
  'demonstration-plan': {
    label: 'Demonstration Plan',
    badgeClass: 'bg-blue-50 text-blue-800 border-blue-200/80',
  },
  'lab-manual': {
    label: 'Lab Manual',
    badgeClass: 'bg-purple-50 text-purple-800 border-purple-200/80',
  },
  'notes': {
    label: 'Subject Notes',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200/80',
  },
  'diagram': {
    label: 'Technical Diagram',
    badgeClass: 'bg-rose-50 text-rose-800 border-rose-200/80',
  },
  'video': {
    label: 'Demonstration Video',
    badgeClass: 'bg-indigo-50 text-indigo-800 border-indigo-200/80',
  },
  'question-bank': {
    label: 'Question Bank',
    badgeClass: 'bg-teal-50 text-teal-800 border-teal-200/80',
  },
  'reference': {
    label: 'Reference Guide',
    badgeClass: 'bg-slate-100 text-slate-800 border-slate-300',
  },
};

const badgeInfo = typeBadgeConfig[resource.resource_type] || {
  label: resource.resource_type,
  badgeClass: 'bg-gray-100 text-gray-800 border-gray-300',
};

// Distinct color + icon per trade for the trade pill
const tradeBadgeConfig: Record<string, { label: string; badgeClass: string; icon: any }> = {
  ictsm: {
    label: 'ICTSM',
    badgeClass: 'bg-indigo-50 text-indigo-800 border-indigo-200/80',
    icon: Cpu,
  },
  electrician: {
    label: 'Electrician',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200/80',
    icon: Zap,
  },
  fitter: {
    label: 'Fitter',
    badgeClass: 'bg-rose-50 text-rose-800 border-rose-200/80',
    icon: Wrench,
  },
  copa: {
    label: 'COPA',
    badgeClass: 'bg-blue-50 text-blue-800 border-blue-200/80',
    icon: Terminal,
  },
};

const tradeBadge = tradeBadgeConfig[resource.trade_slug] || {
  label: resource.trade_name,
  badgeClass: 'bg-gray-100 text-gray-800 border-gray-300',
  icon: Layers,
};
const TradeIcon = tradeBadge.icon;

const primaryFile = resource.files.find((f) => f.is_primary) || resource.files[0];
const fileExt = primaryFile ? primaryFile.original_filename.split('.').pop()?.toUpperCase() : 'PDF';

// Training year formatted as 1st Year or 2nd Year
const yearText = resource.training_year === 1 ? '1st Year' : `${resource.training_year}nd Year`;
const jobNumberText = resource.job_number || `Job #${resource.sort_order || 1}`;

// "This Week" badge for resources published within the last 7 days
const publishedDate = resource.published_at ? new Date(resource.published_at) : null;
const now = new Date();
const isThisWeek = publishedDate ? now.getTime() - publishedDate.getTime() <= 7 * 24 * 60 * 60 * 1000 : false;

// Distinctive colors for 1st Year vs 2nd Year badges
const yearBadgeClass = resource.training_year === 1
  ? 'bg-blue-50 text-blue-700 border-blue-200/70'
  : 'bg-purple-50 text-purple-700 border-purple-200/70';
---

<article class="group relative flex flex-col justify-between bg-white rounded-xl border border-[#e5e5e5] p-5 hover:border-[#b3b3b3] hover:shadow-md transition-all">
  <div>
    <!-- Top Row: Type Badge, Trade & This Week Pill -->
    <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
      <div class="flex items-center gap-1.5 flex-wrap">
        <!-- Badge with distinct color per resource type -->
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeInfo.badgeClass}`}>
          {badgeInfo.label}
        </span>
        <!-- Trade pill with distinct color and icon per trade -->
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold border flex-wrap">
          <TradeIcon class="w-3 h-3" />
          {tradeBadge.label}
        </span>
      </div>

      {isThisWeek && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#00b48a] bg-[#00d4a4]/10 px-2 py-0.5 rounded-full border border-[#00d4a4]/20">
          <Clock class="w-3 h-3" />
          This Week
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-[16px] font-semibold text-[#0a0a0a] group-hover:text-[#00b48a] transition-colors leading-snug mb-2 line-clamp-2">
      <a href={`/resources/${resource.slug}`} class="focus:outline-none focus:underline">
        {resource.title}
      </a>
    </h3>

    <!-- Subject Name -->
    <p class="text-xs font-medium text-[#5a5a5c] mb-2 flex items-center gap-1">
      <Layers class="w-3.5 h-3.5 text-[#888888]" />
      <span>{resource.subject_name}</span>
    </p>

    <!-- Description Excerpt -->
    {!compact && (
      <p class="text-xs text-[#5a5a5c] line-clamp-2 mb-4 leading-relaxed">
        {resource.description}
      </p>
    )}

    <!-- Tags -->
    {resource.tags && resource.tags.length > 0 && !compact && (
      <div class="flex items-center gap-1.5 flex-wrap mb-4">
        {resource.tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] text-[#5a5a5c] bg-[#fafafa] border border-[#ededed] px-1.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Row / Footer: Year, Job Number, Format, and Icon-only Action Buttons -->
  <div class="pt-3 border-t border-[#ededed] flex items-center justify-between gap-2 text-xs">
    
    <!-- Left Metadata: Format, 1st/2nd Year, Job Number (File size removed) -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="font-mono px-1.5 py-0.5 bg-[#f7f7f7] border border-[#e5e5e5] rounded text-[10px] font-medium text-[#0a0a0a]">
        {fileExt}
      </span>
      <span class={`px-2 py-0.5 rounded text-[11px] font-medium border ${yearBadgeClass}`}>
        {yearText}
      </span>
      <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200/70 rounded text-[11px] font-mono font-medium">
        {jobNumberText}
      </span>
    </div>

    <!-- Right Actions: Icon-only buttons with tooltips / aria-labels (text removed) -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <a
        href={`/resources/${resource.slug}`}
        class="inline-flex items-center justify-center p-2 rounded-full text-[#1c1c1e] bg-[#f7f7f7] hover:bg-[#e5e5e5] transition-colors focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
        title="Preview Document"
        aria-label="Preview Document"
      >
        <Eye class="w-4 h-4" />
        <span class="sr-only">Preview Document</span>
      </a>

      {primaryFile && (
        <a
          href={primaryFile.download_url}
          download={primaryFile.original_filename}
          class="inline-flex items-center justify-center p-2 rounded-full text-white bg-[#0a0a0a] hover:bg-[#1c1c1e] transition-colors focus:outline-none focus:ring-2 focus:ring-[#00d4a4]"
          title="Download File"
          aria-label="Download File"
        >
          <Download class="w-4 h-4 text-[#00d4a4]" />
          <span class="sr-only">Download File</span>
        </a>
      )}
    </div>

  </div>
</article>
