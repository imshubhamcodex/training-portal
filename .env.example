# ITI Resource Hub - Environment Configuration Example
# Copy this file to .env or .env.local and populate with your credentials.

# Public Supabase API credentials (safe for browser)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-side Supabase secret key (NEVER commit or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME="ITI Resource Hub"
